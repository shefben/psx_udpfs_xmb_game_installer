# EE build of one installer variant. Invoked by the top-level Makefile;
# do not call directly.
#
#   VARIANT      app | bootstrap | dev
#   BUILD        object directory (one per variant)
#   EE_BIN       output ELF
#   IRX_DIR      directory with smap/ministack/udpfs_ioman.irx
#   EMBED_KELFS  "<symbol>=<file> ..." signed KELFs to embed
#                (opl_launcher_kelf, installer_kelf)
#
# Pattern follows ps2-usbhdl's Makefile (b681bc6): IRX modules and
# assets are embedded as bin2c blobs so nothing is loaded from media.

VARIANT ?= dev
BUILD ?= build/$(VARIANT)
EE_BIN ?= $(BUILD)/desr-udpfs-installer-$(VARIANT).elf
IRX_DIR ?= build/irx
EMBED_KELFS ?=

SRC_DIR := src

SRCS := main.c app_state.c iop_boot.c network.c source.c source_udpfs.c \
        iso9660.c hdl_plan.c hdl_header.c hdl_install.c hdd_partitions.c \
        pfs_channel.c apa_osd_header.c opl_dependency.c opl_launcher_payload.c \
        xmb_installer_app.c xmb_game_channel.c xmb_text.c transaction.c \
        settings.c ui.c partname.c errors.c util.c game_pair.c browser.c flows.c \
        diagnostics.c crc32.c sha256.c batch.c manifest.c \
        server_assets.c ui_style.c rw_buffer.c

# <bin2c symbol>=<file>. Standard PS2SDK modules, then the HDD driver
# (source-built, see tools/driver/), hdlfs (HDLGameInstaller ec37c81),
# the Neutrino network modules and the jacket images.
SDK_IRX := iomanX fileXio poweroff ps2dev9 ps2atad ps2fs sio2man padman
BLOBS := $(foreach m,$(SDK_IRX),$(m)_irx=$(PS2SDK)/iop/irx/$(m).irx) \
         ps2hdd_hdl_irx=vendor/irx/ps2hdd-hdl.irx \
         hdlfs_irx=reference/HDLGameInstaller/irx/hdlfs.irx \
         smap_irx=$(IRX_DIR)/smap.irx \
         ministack_irx=$(IRX_DIR)/ministack.irx \
         udpfs_ioman_irx=$(IRX_DIR)/udpfs_ioman.irx \
         default_jkt_png=assets/game/default_jkt_001.png \
         installer_jkt_png=assets/installer/jkt_001.png \
         $(EMBED_KELFS)

blob_sym = $(firstword $(subst =, ,$(1)))
blob_file = $(word 2,$(subst =, ,$(1)))
BLOB_SYMS := $(foreach b,$(BLOBS),$(call blob_sym,$(b)))
BLOB_FILES := $(foreach b,$(BLOBS),$(call blob_file,$(b)))

EE_OBJS := $(addprefix $(BUILD)/,$(SRCS:.c=.o)) $(BUILD)/build_info.o \
           $(addprefix $(BUILD)/blob_,$(addsuffix .o,$(BLOB_SYMS)))

ifeq ($(VARIANT),app)
EE_CFLAGS += -DVARIANT_APP
else ifeq ($(VARIANT),bootstrap)
EE_CFLAGS += -DVARIANT_BOOTSTRAP
else ifeq ($(VARIANT),dev)
EE_CFLAGS += -DVARIANT_DEV
else
$(error VARIANT must be app, bootstrap or dev)
endif
ifneq ($(filter opl_launcher_kelf,$(BLOB_SYMS)),)
EE_CFLAGS += -DHAVE_EMBEDDED_OPL_LAUNCHER
endif
ifneq ($(filter installer_kelf,$(BLOB_SYMS)),)
EE_CFLAGS += -DHAVE_EMBEDDED_INSTALLER_KELF
endif

EE_LIBS = -ldebug -lhdd -lpoweroff -lfileXio -lpatches -lpad
EE_CFLAGS += -std=gnu11 -Wextra -Werror -Wno-unused-parameter -D_EE
EE_INCS += -I$(SRC_DIR)

all: $(EE_BIN)

# Flags are part of each object's identity: a variant's objects live in
# their own BUILD dir, and a flags stamp forces a rebuild if they change.
$(BUILD)/.flags: FORCE
	@mkdir -p $(@D)
	@echo '$(EE_CFLAGS) $(BLOBS)' | cmp -s - $@ || echo '$(EE_CFLAGS) $(BLOBS)' > $@

$(BUILD)/%.o: $(SRC_DIR)/%.c $(wildcard $(SRC_DIR)/*.h) $(BUILD)/.flags
	@mkdir -p $(@D)
	$(EE_CC) $(EE_CFLAGS) $(EE_INCS) -c $< -o $@

# Per-blob bin2c rules.
define BLOB_RULE
$(BUILD)/blob_$(call blob_sym,$(1)).c: $(call blob_file,$(1))
	@mkdir -p $$(@D)
	bin2c $$< $$@ $(call blob_sym,$(1))
endef
$(foreach b,$(BLOBS),$(eval $(call BLOB_RULE,$(b))))

$(BUILD)/blob_%.o: $(BUILD)/blob_%.c
	$(EE_CC) $(EE_CFLAGS) -c $< -o $@

GITID_STAMP ?=
$(BUILD)/build_info.c: $(BLOB_FILES) tools/gen-build-info.sh $(BUILD)/.flags $(GITID_STAMP)
	bash tools/gen-build-info.sh $@ $(VARIANT) $(BLOBS)

$(BUILD)/build_info.o: $(BUILD)/build_info.c $(SRC_DIR)/build_info.h
	$(EE_CC) $(EE_CFLAGS) $(EE_INCS) -c $< -o $@

# $(EE_BIN) is linked by the PS2SDK rule in Makefile.eeglobal.

FORCE:
.PHONY: all FORCE
.SECONDARY:

include $(PS2SDK)/samples/Makefile.pref
include $(PS2SDK)/samples/Makefile.eeglobal
