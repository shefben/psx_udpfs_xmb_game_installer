diff -ruN a/iop/ministack/include/dhcp.h b/iop/ministack/include/dhcp.h
--- a/iop/ministack/include/dhcp.h	1969-12-31 18:00:00.000000000 -0600
+++ b/iop/ministack/include/dhcp.h	2026-10-05 13:00:38.394205695 -0500
@@ -0,0 +1,23 @@
+#ifndef MINISTACK_DHCP_H
+#define MINISTACK_DHCP_H
+
+#include <stdint.h>
+
+/* Result written to EE memory ("out=" argument), 16 bytes. The EE copy
+ * of this layout is src/net_dhcp.h in the installer. */
+#define DHCP_RESULT_MAGIC 0x50484344u /* "DCHP" */
+#define DHCP_STATUS_LEASED 1
+#define DHCP_STATUS_NO_ANSWER 2 /* fallback address kept */
+#define DHCP_STATUS_FAILED 3
+
+typedef struct
+{
+    uint32_t magic;
+    uint32_t ip;     /* address in use (host order) */
+    uint32_t server; /* DHCP server, 0 if none */
+    uint32_t status;
+} dhcp_result_t;
+
+void dhcp_run(uint32_t fallback_ip, uint32_t ee_addr);
+
+#endif
diff -ruN a/iop/ministack/src/dhcp.c b/iop/ministack/src/dhcp.c
--- a/iop/ministack/src/dhcp.c	1969-12-31 18:00:00.000000000 -0600
+++ b/iop/ministack/src/dhcp.c	2026-10-05 13:00:38.390205505 -0500
@@ -0,0 +1,144 @@
+/*
+ * DHCP client for ministack (added by the PSX DESR UDPFS installer).
+ *
+ * Runs once, synchronously, from _start when the module is loaded with
+ * "dhcp=1": DISCOVER -> OFFER -> REQUEST -> ACK, retransmitting every
+ * DHCP_RETRY_MS (the first ones may be lost while the PHY negotiates).
+ * On success the leased address becomes ministack's address; otherwise
+ * the "ip=" address stays (static fallback). No lease renewal: an
+ * installer session is far shorter than any lease.
+ *
+ * With "out=<EE address>", the result (dhcp_result_t) is written to EE
+ * memory by SIF DMA so the EE can show the address.
+ */
+#include <stdio.h>
+#include <sysclib.h>
+#include <thbase.h>
+#include <sifman.h>
+#include <intrman.h>
+
+#include "main.h"
+#include "smap.h"
+#include "ministack_ip.h"
+#include "ministack_udp.h"
+#include "dhcp_proto.h"
+#include "dhcp.h"
+
+#define DHCP_RETRY_MS 1500
+#define DHCP_TOTAL_MS 12000
+
+static udp_packet_t pkt __attribute__((aligned(64)));
+static uint8_t msg[DHCP_MSG_MAX] __attribute__((aligned(64)));
+static uint8_t rx[DHCP_MSG_MAX] __attribute__((aligned(64)));
+static uint8_t rx_fifo[DHCP_MSG_MAX + 4] __attribute__((aligned(64)));
+static volatile int rx_len;
+static uint8_t mac[6];
+
+/* RX handler (SMAP context): copy the UDP payload, never consume the
+ * frame (return -1 so SMAP skips to the next one). */
+static int dhcp_rx(udp_socket_t *s, void *arg, const uint8_t *hdr, uint16_t hdr_len)
+{
+    (void)s;
+    (void)arg;
+    const udp_packet_t *p = (const udp_packet_t *)hdr;
+    uint32_t n = ntohs(p->udp.len);
+    if (rx_len || hdr_len < 44 || n < 8 + 241 || n - 8 > DHCP_MSG_MAX)
+        return -1;
+    n -= 8;
+    /* hdr holds the first 2 payload bytes; the rest from frame offset 44,
+     * read in whole words into an aligned buffer. */
+    rx[0] = hdr[42];
+    rx[1] = hdr[43];
+    smap_fifo_read(44, rx_fifo, (n - 2 + 3) & ~3u);
+    memcpy(rx + 2, rx_fifo, n - 2);
+    rx_len = (int)n;
+    return -1;
+}
+
+static void send_msg(udp_socket_t *s, int type, uint32_t xid, uint32_t req_ip, uint32_t sid)
+{
+    size_t n = dhcp_build(msg, type, xid, mac, req_ip, sid);
+    udp_packet_init(&pkt, 0xFFFFFFFF, 67);
+    udp_packet_send_ll(s, &pkt, 0, msg, (uint16_t)n);
+}
+
+/* Wait up to ms for a reply of `want` (or NAK); 0 / -1. */
+static int wait_reply(uint32_t xid, int want, dhcp_reply_t *r, int ms)
+{
+    for (int t = 0; t < ms; t += 20) {
+        if (rx_len) {
+            int ok = dhcp_parse(rx, (size_t)rx_len, xid, mac, r) == 0 &&
+                     (r->type == want || r->type == DHCP_NAK);
+            rx_len = 0;
+            if (ok)
+                return 0;
+        }
+        DelayThread(20 * 1000);
+    }
+    return -1;
+}
+
+static void report(uint32_t ee_addr, const dhcp_result_t *res)
+{
+    static dhcp_result_t buf __attribute__((aligned(64)));
+    SifDmaTransfer_t t;
+    int id, st;
+
+    if (!ee_addr)
+        return;
+    buf = *res;
+    t.src = &buf;
+    t.dest = (void *)ee_addr;
+    t.size = sizeof(buf);
+    t.attr = 0;
+    CpuSuspendIntr(&st);
+    id = sceSifSetDma(&t, 1);
+    CpuResumeIntr(st);
+    while (id && sceSifDmaStat(id) >= 0)
+        DelayThread(1000);
+}
+
+void dhcp_run(uint32_t fallback_ip, uint32_t ee_addr)
+{
+    dhcp_result_t res = {DHCP_RESULT_MAGIC, fallback_ip, 0, DHCP_STATUS_NO_ANSWER};
+    dhcp_reply_t r;
+    udp_socket_t *s;
+    uint32_t xid;
+    int t = 0;
+
+    SMAPGetMACAddress(mac);
+    xid = ((uint32_t)mac[2] << 24 | (uint32_t)mac[3] << 16 | (uint32_t)mac[4] << 8 | mac[5]) ^
+          0x5053581u;
+    s = udp_bind(68, dhcp_rx, NULL);
+    if (s == NULL) {
+        res.status = DHCP_STATUS_FAILED;
+        report(ee_addr, &res);
+        return;
+    }
+    ms_ip_set_ip(0); /* 0.0.0.0 while asking */
+    while (t < DHCP_TOTAL_MS) {
+        xid++;
+        send_msg(s, DHCP_DISCOVER, xid, 0, 0);
+        t += DHCP_RETRY_MS;
+        if (wait_reply(xid, DHCP_OFFER, &r, DHCP_RETRY_MS) < 0 || r.type != DHCP_OFFER)
+            continue;
+        uint32_t offer = r.yiaddr, sid = r.server_id;
+        for (int i = 0; i < 3; i++) {
+            send_msg(s, DHCP_REQUEST, xid, offer, sid);
+            t += DHCP_RETRY_MS;
+            if (wait_reply(xid, DHCP_ACK, &r, DHCP_RETRY_MS) == 0)
+                break;
+            r.type = 0;
+        }
+        if (r.type == DHCP_ACK && r.yiaddr) {
+            res.ip = r.yiaddr;
+            res.server = sid;
+            res.status = DHCP_STATUS_LEASED;
+            break;
+        }
+        /* NAK or no ACK: start over with a new DISCOVER. */
+    }
+    ms_ip_set_ip(res.ip);
+    M_DEBUG("dhcp: status %d ip %08x\n", (int)res.status, (unsigned)res.ip);
+    report(ee_addr, &res);
+}
