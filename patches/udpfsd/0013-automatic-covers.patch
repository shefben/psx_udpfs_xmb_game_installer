+	if strings.Contains(head, "scanning=1") || len(entries) != 1 ||
+		!strings.Contains(entries[0], "\tjkt/SLUS_203.12.png\t") {
+		t.Fatalf("%q %q", head, entries)
+	}
+	if !bothJackets(filepath.Join(ServedDir(cache), "jkt", "SLUS_203.12.png")) {
+		t.Fatal("missing XMB jackets")
+	}
+	if _, err := Run(o); err != nil {
+		t.Fatal(err)
+	}
+	if requests != 1 {
+		t.Fatalf("cover downloaded %d times", requests)
+	}
