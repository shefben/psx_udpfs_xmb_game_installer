+// bothJackets reports whether the list jacket and its large cover exist
+// at the current sizes (a cache from an older release is remade).
+func bothJackets(jkt string) bool {
+	return pngSize(jkt, JacketW, JacketH) && pngSize(LargeJacketPath(jkt), LargeJacketW, LargeJacketH)
+}
+
+func pngSize(path string, w, h int) bool {
+	f, err := os.Open(path)
+	if err != nil {
+		return false
+	}
+	defer f.Close()
+	cfg, format, err := image.DecodeConfig(f)
+	return err == nil && format == "png" && cfg.Width == w && cfg.Height == h
+}
