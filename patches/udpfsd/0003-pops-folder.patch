+
+func TestPOPSFolderKey(t *testing.T) {
+	base := t.TempDir()
+	if err := os.Mkdir(filepath.Join(base, "POPS"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	p := write(t, base, "udpfsd.cfg", "pops = POPS\n")
+	c, err := Load(p, base)
+	if err != nil || c.POPS != filepath.Join(base, "POPS") {
+		t.Fatalf("%v %q", err, c.POPS)
+	}
+	if c.HasGameFolders() != false {
+		t.Fatal("a POPS folder alone is not a PS2 game folder")
+	}
+	p = write(t, base, "udpfsd.cfg", "pops = nothere\n")
+	if _, err := Load(p, base); err == nil {
+		t.Fatal("missing pops folder accepted")
+	}
+}
