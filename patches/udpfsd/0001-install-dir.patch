diff --git a/internal/fs/installdir.go b/internal/fs/installdir.go
new file mode 100644
index 0000000..784722e
--- /dev/null
+++ b/internal/fs/installdir.go
@@ -0,0 +1,131 @@
+package fs
+
+import (
+	"fmt"
+	"io/fs"
+	"log"
+	"os"
+	"path/filepath"
+	"strings"
+)
+
+// InstallDirName is the virtual directory under which the -install-dir
+// folder appears to clients (udpfs:/INSTALL). The PSX DESR installer
+// installs every game found there in one batch.
+const InstallDirName = "INSTALL"
+
+// virtualRoot stands for "/" when only -install-dir is served (no
+// -fsroot): the root then contains nothing but the INSTALL directory.
+const virtualRoot = "\x00udpfsd-virtual-root"
+
+// WithInstallDir serves path read-only as /INSTALL.
+func WithInstallDir(path string) func(s *Backend) {
+	return func(s *Backend) {
+		if path != "" {
+			s.installDir = path
+		}
+	}
+}
+
+func (s *Backend) initInstallDir() error {
+	if s.installDir == "" {
+		return nil
+	}
+	abs, err := filepath.Abs(s.installDir)
+	if err != nil {
+		return err
+	}
+	info, err := os.Stat(abs)
+	if err != nil || !info.IsDir() {
+		return fmt.Errorf("install dir %s is not a directory", s.installDir)
+	}
+	s.installDir = abs
+	if s.fsRoot != "" {
+		if st, err := os.Stat(filepath.Join(s.fsRoot, InstallDirName)); err == nil && st.IsDir() {
+			log.Printf("fs: warning: %s/%s is hidden by -install-dir", s.fsRoot, InstallDirName)
+		}
+	}
+	return nil
+}
+
+// splitInstallPath reports whether a normalized client path (no leading
+// separator) addresses the install directory, and returns the remainder.
+func splitInstallPath(clientPath string) (rest string, ok bool) {
+	if clientPath == InstallDirName {
+		return "", true
+	}
+	prefix := InstallDirName + string(os.PathSeparator)
+	if strings.HasPrefix(clientPath, prefix) {
+		return strings.TrimPrefix(clientPath, prefix), true
+	}
+	return "", false
+}
+
+// underRoot joins rel to root and checks the result stays inside root.
+func underRoot(root, rel string) (string, bool) {
+	resolved, err := filepath.Abs(filepath.Join(root, rel))
+	if err != nil {
+		return "", false
+	}
+	cleanRoot := filepath.Clean(root)
+	comparableRoot := strings.TrimSuffix(cleanRoot, string(os.PathSeparator))
+	if !strings.HasPrefix(resolved, comparableRoot+string(os.PathSeparator)) && resolved != cleanRoot {
+		return "", false
+	}
+	return resolved, true
+}
+
+// inInstallDir reports whether a resolved host path lies in the install dir.
+func (s *Backend) inInstallDir(resolved string) bool {
+	if s.installDir == "" || resolved == "" || resolved == virtualRoot {
+		return false
+	}
+	return resolved == s.installDir ||
+		strings.HasPrefix(resolved, s.installDir+string(os.PathSeparator))
+}
+
+// isRootDir reports whether a resolved host path is the client's "/".
+func (s *Backend) isRootDir(resolved string) bool {
+	if resolved == virtualRoot {
+		return true
+	}
+	return s.fsRoot != "" && resolved == filepath.Clean(s.fsRoot)
+}
+
+// renamedEntry presents the install directory as "INSTALL" in "/".
+type renamedEntry struct {
+	fs.DirEntry
+	name string
+}
+
+func (e renamedEntry) Name() string { return e.name }
+
+func (s *Backend) installDirEntry() (fs.DirEntry, error) {
+	info, err := os.Stat(s.installDir)
+	if err != nil {
+		return nil, err
+	}
+	return renamedEntry{fs.FileInfoToDirEntry(info), InstallDirName}, nil
+}
+
+// rootEntries lists "/" with the INSTALL directory added (and a real
+// fsroot/INSTALL, if any, hidden).
+func (s *Backend) rootEntries(resolved string) ([]os.DirEntry, error) {
+	var entries []os.DirEntry
+	if resolved != virtualRoot {
+		real, err := os.ReadDir(resolved)
+		if err != nil {
+			return nil, err
+		}
+		for _, e := range real {
+			if e.Name() != InstallDirName {
+				entries = append(entries, e)
+			}
+		}
+	}
+	e, err := s.installDirEntry()
+	if err != nil {
+		return nil, err
+	}
+	return append(entries, e), nil
+}
diff --git a/internal/fs/installdir_test.go b/internal/fs/installdir_test.go
new file mode 100644
index 0000000..165b8aa
--- /dev/null
+++ b/internal/fs/installdir_test.go
@@ -0,0 +1,193 @@
+package fs
+
+import (
+	"os"
+	"path/filepath"
+	"sort"
+	"testing"
+)
+
+func mkfile(t *testing.T, path string, data string) {
+	t.Helper()
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte(data), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func listDir(t *testing.T, b *Backend, path string) []string {
+	t.Helper()
+	h, _, err := b.Open(path, os.O_RDONLY, true)
+	if err != nil || h < 0 {
+		t.Fatalf("open dir %q: handle %d err %v", path, h, err)
+	}
+	defer b.Close(h)
+	var names []string
+	for {
+		ok, name, _, err := b.Dread(h)
+		if err != nil {
+			t.Fatalf("dread %q: %v", path, err)
+		}
+		if !ok {
+			break
+		}
+		names = append(names, name)
+	}
+	sort.Strings(names)
+	return names
+}
+
+func readAll(t *testing.T, b *Backend, path string) (string, error) {
+	t.Helper()
+	h, _, err := b.Open(path, os.O_RDONLY, false)
+	if err != nil {
+		return "", err
+	}
+	defer b.Close(h)
+	buf := make([]byte, 4096)
+	n, data, err := b.Read(h, uint32(len(buf)), buf)
+	if err != nil {
+		return "", err
+	}
+	return string(data[:n]), nil
+}
+
+func eq(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+func setup(t *testing.T, withRoot bool, readOnly bool) (*Backend, string, string) {
+	t.Helper()
+	base := t.TempDir()
+	root := filepath.Join(base, "root")
+	inst := filepath.Join(base, "queue")
+	mkfile(t, filepath.Join(root, "DVD", "A.iso"), "root-a")
+	mkfile(t, filepath.Join(root, "INSTALL", "shadowed.iso"), "shadowed")
+	mkfile(t, filepath.Join(inst, "B.iso"), "queue-b")
+	mkfile(t, filepath.Join(inst, "DVD", "C.iso"), "queue-c")
+	mkfile(t, filepath.Join(base, "secret.txt"), "secret")
+	opts := []BackendOptFunc{WithInstallDir(inst)}
+	if withRoot {
+		opts = append(opts, WithFSRoot(root))
+	}
+	if readOnly {
+		opts = append(opts, WithReadOnly())
+	}
+	b, err := NewBackend(opts...)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b, root, inst
+}
+
+func TestInstallDirListedInRoot(t *testing.T) {
+	b, _, _ := setup(t, true, true)
+	if got := listDir(t, b, "/"); !eq(got, []string{"DVD", "INSTALL"}) {
+		t.Fatalf("root listing %v", got)
+	}
+	// The real fsroot/INSTALL is hidden by the install dir.
+	if got := listDir(t, b, "/INSTALL"); !eq(got, []string{"B.iso", "DVD"}) {
+		t.Fatalf("/INSTALL listing %v", got)
+	}
+	if got := listDir(t, b, "/INSTALL/DVD"); !eq(got, []string{"C.iso"}) {
+		t.Fatalf("/INSTALL/DVD listing %v", got)
+	}
+}
+
+func TestInstallDirFilesReadable(t *testing.T) {
+	b, _, _ := setup(t, true, true)
+	for path, want := range map[string]string{
+		"/INSTALL/B.iso":        "queue-b",
+		"INSTALL/DVD/C.iso":     "queue-c",
+		"\\INSTALL\\B.iso":      "queue-b",
+		"/DVD/A.iso":            "root-a",
+		"/INSTALL/../DVD/A.iso": "root-a", // Clean() first: an fsroot path
+	} {
+		got, err := readAll(t, b, path)
+		if err != nil || got != want {
+			t.Fatalf("read %q = %q, %v; want %q", path, got, err, want)
+		}
+	}
+}
+
+func TestInstallDirNoEscape(t *testing.T) {
+	b, _, _ := setup(t, true, true)
+	for _, path := range []string{"/INSTALL/../../secret.txt", "/../secret.txt", "/../queue/B.iso", "/INSTALL/../../queue/B.iso"} {
+		if _, err := readAll(t, b, path); err == nil {
+			t.Fatalf("read %q succeeded", path)
+		}
+	}
+}
+
+func TestInstallDirIsReadOnlyEvenWithoutRO(t *testing.T) {
+	b, _, inst := setup(t, true, false)
+	if _, _, err := b.Open("/INSTALL/new.iso", os.O_RDWR|os.O_CREATE, false); err == nil {
+		t.Fatal("create in install dir succeeded")
+	}
+	if _, _, err := b.Open("/INSTALL/B.iso", os.O_WRONLY, false); err == nil {
+		t.Fatal("open for write in install dir succeeded")
+	}
+	if err := b.Remove("/INSTALL/B.iso"); err == nil {
+		t.Fatal("remove in install dir succeeded")
+	}
+	if err := b.Mkdir("/INSTALL/x"); err == nil {
+		t.Fatal("mkdir in install dir succeeded")
+	}
+	if err := b.Rmdir("/INSTALL/DVD"); err == nil {
+		t.Fatal("rmdir in install dir succeeded")
+	}
+	if _, err := os.Stat(filepath.Join(inst, "B.iso")); err != nil {
+		t.Fatal("install dir file was modified")
+	}
+	// fsroot stays writable without -ro.
+	if err := b.Mkdir("/newdir"); err != nil {
+		t.Fatalf("mkdir in fsroot: %v", err)
+	}
+}
+
+func TestInstallDirOnlyMode(t *testing.T) {
+	b, _, _ := setup(t, false, true)
+	if got := listDir(t, b, "/"); !eq(got, []string{"INSTALL"}) {
+		t.Fatalf("root listing %v", got)
+	}
+	if got, err := readAll(t, b, "/INSTALL/B.iso"); err != nil || got != "queue-b" {
+		t.Fatalf("read = %q, %v", got, err)
+	}
+	if _, err := readAll(t, b, "/DVD/A.iso"); err == nil {
+		t.Fatal("fsroot path served without -fsroot")
+	}
+	if _, _, err := b.Open("/", os.O_RDONLY, false); err == nil {
+		t.Fatal("opened virtual root as a file")
+	}
+}
+
+func TestNoInstallDirUnchanged(t *testing.T) {
+	base := t.TempDir()
+	mkfile(t, filepath.Join(base, "INSTALL", "x.iso"), "x")
+	b, err := NewBackend(WithFSRoot(base), WithReadOnly())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := listDir(t, b, "/"); !eq(got, []string{"INSTALL"}) {
+		t.Fatalf("root listing %v", got)
+	}
+	if got, err := readAll(t, b, "/INSTALL/x.iso"); err != nil || got != "x" {
+		t.Fatalf("read = %q, %v", got, err)
+	}
+}
+
+func TestInstallDirMustExist(t *testing.T) {
+	if _, err := NewBackend(WithInstallDir(filepath.Join(t.TempDir(), "missing"))); err == nil {
+		t.Fatal("missing install dir accepted")
+	}
+}
