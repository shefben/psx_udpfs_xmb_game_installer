diff --git a/internal/config/config_test.go b/internal/config/config_test.go
index 6728bb6..e12221f 100644
--- a/internal/config/config_test.go
+++ b/internal/config/config_test.go
@@ -186,3 +186,35 @@ func TestAPPSFolderKey(t *testing.T) {
 		t.Fatal("missing apps folder accepted")
 	}
 }
+
+func TestVMCAndCHTFolderKeys(t *testing.T) {
+	base := t.TempDir()
+	for _, d := range []string{"VMC", "CHT"} {
+		if err := os.Mkdir(filepath.Join(base, d), 0o755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	p := write(t, base, "udpfsd.cfg", "vmc = VMC\ncht = "+filepath.Join(base, "CHT")+"\n")
+	c, err := Load(p, base)
+	if err != nil || c.VMC != filepath.Join(base, "VMC") || c.CHT != filepath.Join(base, "CHT") {
+		t.Fatalf("%v %q %q", err, c.VMC, c.CHT)
+	}
+	if c.HasGameFolders() {
+		t.Fatal("VMC/CHT folders are not PS2 game folders")
+	}
+	for _, key := range []string{"vmc", "cht"} {
+		p = write(t, base, "udpfsd.cfg", key+" = nothere\n")
+		if _, err := Load(p, base); err == nil {
+			t.Fatalf("missing %s folder accepted", key)
+		}
+		write(t, base, "afile", "x")
+		p = write(t, base, "udpfsd.cfg", key+" = afile\n")
+		if _, err := Load(p, base); err == nil {
+			t.Fatalf("%s = a file accepted", key)
+		}
+		p = write(t, base, "udpfsd.cfg", key+" =\n")
+		if c, err := Load(p, base); err != nil || c.VMC != "" || c.CHT != "" {
+			t.Fatalf("empty %s: %v", key, err)
+		}
+	}
+}
