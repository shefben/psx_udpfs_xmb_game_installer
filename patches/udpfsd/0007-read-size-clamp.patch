diff --git a/udpfs/handlers_test.go b/udpfs/handlers_test.go
new file mode 100644
index 0000000..1387f20
--- /dev/null
+++ b/udpfs/handlers_test.go
@@ -0,0 +1,65 @@
+package udpfs
+
+import (
+	"encoding/binary"
+	"net"
+	"testing"
+
+	"github.com/pcm720/udpfsd/udprdma"
+)
+
+// readFS records what the protocol layer passes to Read/Bread and slices the
+// buffer the way the real backend does (a size past the buffer would panic).
+type readFS struct {
+	FS
+	gotSize   uint32
+	gotBufLen int
+}
+
+func (f *readFS) Read(handle int32, size uint32, buf []byte) (int32, []byte, error) {
+	f.gotSize, f.gotBufLen = size, len(buf)
+	return int32(size), buf[:size], nil
+}
+
+func (f *readFS) Bread(handle int32, sectorNr int64, sectorCount uint16, buf []byte) ([]byte, error) {
+	f.gotBufLen = len(buf)
+	n := min(int(sectorCount), len(buf)/512) * 512
+	return buf[:n], nil
+}
+
+func newTestConn(t *testing.T, fs FS) (*Connection, *net.UDPAddr) {
+	t.Helper()
+	addr := &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 1}
+	sess := udprdma.NewSession(*addr, func(*net.UDPAddr, []byte) {}, nil)
+	c := NewConnection(sess, fs, false, false)
+	t.Cleanup(c.Close)
+	return c, addr
+}
+
+func TestReadRequestLargerThanBufferIsClamped(t *testing.T) {
+	fs := &readFS{}
+	c, addr := newTestConn(t, fs)
+	for _, size := range []uint32{64 * 1024, 128 * 1024, 128*1024 + 1, 1 << 20, 0xFFFFFFFF} {
+		req := make([]byte, 12)
+		req[0] = byte(MsgReadReq)
+		binary.LittleEndian.PutUint32(req[4:], 1)
+		binary.LittleEndian.PutUint32(req[8:], size)
+		c.HandlePayload(addr, req) // must not panic
+		want := min(size, uint32(len(c.dataBuffer)))
+		if fs.gotSize != want || fs.gotBufLen != len(c.dataBuffer) {
+			t.Fatalf("request %d: FS got size %d buffer %d, want %d/%d", size, fs.gotSize, fs.gotBufLen, want, len(c.dataBuffer))
+		}
+	}
+}
+
+func TestBreadRequestGetsWholeBuffer(t *testing.T) {
+	fs := &readFS{}
+	c, addr := newTestConn(t, fs)
+	req := make([]byte, 16)
+	req[0] = byte(MsgBreadReq)
+	binary.LittleEndian.PutUint16(req[2:], 0xFFFF) // 32 MiB of 512-byte sectors
+	c.HandlePayload(addr, req)                     // must not panic
+	if fs.gotBufLen != len(c.dataBuffer) {
+		t.Fatalf("buffer %d", fs.gotBufLen)
+	}
+}
