diff --git a/internal/fs/readsize_test.go b/internal/fs/readsize_test.go
new file mode 100644
index 0000000..a0f1476
--- /dev/null
+++ b/internal/fs/readsize_test.go
@@ -0,0 +1,43 @@
+package fs
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestReadNeverPastBuffer(t *testing.T) {
+	dir := t.TempDir()
+	data := bytes.Repeat([]byte("0123456789abcdef"), 300*1024/16) // 300 KiB
+	mkfile(t, filepath.Join(dir, "big.iso"), string(data))
+	b, err := NewBackend(WithMount("DVD", dir), WithReadOnly())
+	if err != nil {
+		t.Fatal(err)
+	}
+	h, _, err := b.Open("/DVD/big.iso", os.O_RDONLY, false)
+	if err != nil || h <= 0 {
+		t.Fatalf("open: %d %v", h, err)
+	}
+	defer b.Close(h)
+	buf := make([]byte, 128*1024)
+	for _, size := range []uint32{128*1024 + 1, 1 << 20, 0xFFFFFFFF} {
+		if _, err := b.Lseek(h, 0, 0); err != nil {
+			t.Fatal(err)
+		}
+		n, got, err := b.Read(h, size, buf) // must not panic
+		if err != nil || int(n) != len(buf) || !bytes.Equal(got, data[:len(buf)]) {
+			t.Fatalf("read %d: n=%d err=%v", size, n, err)
+		}
+	}
+	// Block read: 0xFFFF sectors of 512 bytes would be 32 MiB.
+	got, err := b.Bread(h, 2, 0xFFFF, buf)
+	if err != nil || len(got) != len(buf) || !bytes.Equal(got, data[1024:1024+len(buf)]) {
+		t.Fatalf("bread: %d bytes, %v", len(got), err)
+	}
+	// A buffer that is not a whole number of sectors: whole sectors only.
+	got, err = b.Bread(h, 0, 10, buf[:1000])
+	if err != nil || len(got) != 512 {
+		t.Fatalf("bread odd buffer: %d bytes, %v", len(got), err)
+	}
+}
