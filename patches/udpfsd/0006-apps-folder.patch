+
+func TestAPPSFolderKey(t *testing.T) {
+	base := t.TempDir()
+	if err := os.Mkdir(filepath.Join(base, "APPS"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	p := write(t, base, "udpfsd.cfg", "apps = APPS\n")
+	c, err := Load(p, base)
+	if err != nil || c.APPS != filepath.Join(base, "APPS") {
+		t.Fatalf("%v %q", err, c.APPS)
+	}
+	if c.HasGameFolders() != false {
+		t.Fatal("an APPS folder alone is not a PS2 game folder")
+	}
+	p = write(t, base, "udpfsd.cfg", "apps = nothere\n")
+	if _, err := Load(p, base); err == nil {
+		t.Fatal("missing apps folder accepted")
+	}
+}
