+	"github.com/pcm720/udpfsd/internal/fs/wire"
+	"github.com/pcm720/udpfsd/udpfs"
+	"github.com/pierrec/lz4/v4"
+)
+
+// readFrames reads a framed handle to EOF with n-byte reads and decodes it.
+func readFrames(t *testing.T, b *Backend, h int32, n uint32) []byte {
+	t.Helper()
+	var out []byte
+	buf := make([]byte, 128*1024)
+	for {
+		got, data, err := b.Read(h, n, buf)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got == 0 {
+			return out
+		}
+		if int(got) != len(data) || got%16 != 0 || uint32(got) > n || binary.LittleEndian.Uint32(data) != wire.Magic {
+			t.Fatalf("frame of %d bytes for a read of %d", got, n)
+		}
+		raw := make([]byte, binary.LittleEndian.Uint32(data[4:]))
+		dl := binary.LittleEndian.Uint32(data[8:])
+		if binary.LittleEndian.Uint32(data[12:])&wire.FlagLZ4 != 0 {
+			if m, err := lz4.UncompressBlock(data[16:16+dl], raw); err != nil || m != len(raw) {
+				t.Fatalf("lz4: %d %v", m, err)
+			}
+		} else {
+			copy(raw, data[16:16+dl])
+		}
+		out = append(out, raw...)
+	}
+}
+
+func TestWireFramesThroughBackend(t *testing.T) {
+	dir := t.TempDir()
+	plain := bytes.Repeat([]byte("frames over UDPFS "), 300*1024/18)
+	mkfile(t, filepath.Join(dir, "a.iso"), string(plain))
+	zso, err := os.ReadFile(filepath.Join("compression", "test", "test.zso"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ref, err := os.ReadFile(filepath.Join("compression", "test", "test.iso"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	mkfile(t, filepath.Join(dir, "g.zso"), string(zso))
+	b, err := NewBackend(WithMount("DVD", dir), WithReadOnly(), WithCompression())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	for path, want := range map[string][]byte{"/.lz4f/DVD/a.iso": plain, "/.lz4f/DVD/g.zso.iso": ref, "\\.lz4f\\DVD\\a.iso": plain} {
+		h, st, err := b.Open(path, os.O_RDONLY, false)
+		if err != nil || h <= 0 {
+			t.Fatalf("open %s: %d %v", path, h, err)
+		}
+		if int64(st.Size)|int64(st.Hisize)<<32 != int64(len(want)) {
+			t.Fatalf("%s: open size %d, want raw %d", path, st.Size, len(want))
+		}
+		if gs, err := b.Getstat(path); err != nil || int(gs.Size) != len(want) {
+			t.Fatalf("%s: getstat %d %v", path, gs.Size, err)
+		}
+		if got := readFrames(t, b, h, 131072); !bytes.Equal(got, want) {
+			t.Fatalf("%s: frames decode to %d bytes, want %d", path, len(got), len(want))
+		}
+		if pos, err := b.Lseek(h, 0, io.SeekEnd); err != nil || pos != int64(len(want)) {
+			t.Fatalf("%s: SEEK_END %d %v", path, pos, err)
+		}
+		if n, data, err := b.Read(h, 131072, make([]byte, 128*1024)); n != 0 || len(data) != 0 || err != nil {
+			t.Fatalf("%s: at EOF: %d %v", path, n, err)
+		}
+		if pos, _ := b.Lseek(h, 4096, io.SeekStart); pos != 4096 {
+			t.Fatal("seek")
+		}
+		if got := readFrames(t, b, h, 4096+16); !bytes.Equal(got, want[4096:]) {
+			t.Fatalf("%s: after seek", path)
+		}
+		if n, _, err := b.Read(h, 2063, make([]byte, 128*1024)); n != 0 || err != udpfs.Errno(-udpfs.EINVAL) {
+			t.Fatalf("%s: read too small: %d %v", path, n, err)
+		}
+		if _, err := b.Bread(h, 0, 4, make([]byte, 4096)); err == nil {
+			t.Fatalf("%s: block read on frames", path)
+		}
+		b.Close(h)
+		if gs, err := b.Getstat(path); err != nil || int(gs.Size) != len(want) {
+			t.Fatalf("%s: getstat when closed %d %v", path, gs.Size, err)
+		}
+	}
+
+	if _, _, err := b.Open("/.lz4f/DVD/a.iso", os.O_RDWR, false); !os.IsPermission(err) {
+		t.Fatalf("framed file opened for writing: %v", err)
+	}
+	if _, _, err := b.Open("/.lz4f/DVD/missing.iso", os.O_RDONLY, false); !os.IsNotExist(err) {
+		t.Fatalf("missing file: %v", err)
+	}
+	if _, _, err := b.Open("/.lz4f/DVD", os.O_RDONLY, true); err == nil {
+		t.Fatal("framed directory opened")
+	}
+	if _, _, err := b.Open("/.lz4f/DVD", os.O_RDONLY, false); err == nil {
+		t.Fatal("framed directory opened as a file")
+	}
+	if names := listDir(t, b, "/"); slices.Contains(names, wire.PathPrefix) {
+		t.Fatalf("root lists %v", names)
+	}
+}
+
+func TestGetstatWithoutOpen(t *testing.T) {
+	f := newFixture(t)
+	b := f.backend(t, true, true)
+	if st, err := b.Getstat("/DVD/A.iso"); err != nil || st.Size != 5 || st.Mode != udpfs.FIO_S_IFREG {
+		t.Fatalf("getstat %+v %v", st, err)
+	}
+	if _, err := b.Getstat("/DVD/missing.iso"); !os.IsNotExist(err) {
+		t.Fatalf("missing: %v", err)
+	}
+}
