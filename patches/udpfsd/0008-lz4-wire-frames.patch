diff --git a/internal/fs/virtual.go b/internal/fs/virtual.go
new file mode 100644
index 0000000..050d577
--- /dev/null
+++ b/internal/fs/virtual.go
@@ -0,0 +1,105 @@
+package fs
+
+import (
+	"log"
+	"os"
+	"path/filepath"
+	"strings"
+
+	"github.com/pcm720/udpfsd/internal/fs/compression"
+	"github.com/pcm720/udpfsd/internal/fs/interfaces"
+	"github.com/pcm720/udpfsd/internal/fs/wire"
+	"github.com/pcm720/udpfsd/udpfs"
+)
+
+// writeFlags are open flags that would change a file.
+const writeFlags = os.O_WRONLY | os.O_RDWR | os.O_CREATE | os.O_TRUNC | os.O_APPEND
+
+// cutVirtualPrefix reports whether a client path starts with the top-level
+// component prefix (".lz4f", ...) and returns the rest ("/DVD/x.iso").
+func cutVirtualPrefix(clientPath, prefix string) (string, bool) {
+	p := strings.TrimLeft(strings.ReplaceAll(clientPath, "\\", "/"), "/")
+	rest, ok := strings.CutPrefix(p, prefix)
+	if !ok || (rest != "" && rest[0] != '/') {
+		return "", false
+	}
+	return "/" + strings.TrimLeft(rest, "/"), true
+}
+
+// openWire opens "/.lz4f/<path>": <path> read-only, served as LZ4 frames.
+func (s *Backend) openWire(inner string, flag int, isDir bool) (int32, udpfs.StatInfo, error) {
+	if isDir || inner == "/" {
+		return 0, udpfs.StatInfo{}, os.ErrNotExist
+	}
+	if flag&writeFlags != 0 {
+		return 0, udpfs.StatInfo{}, os.ErrPermission
+	}
+	fo, err := s.openReadOnly(inner)
+	if err != nil {
+		return 0, udpfs.StatInfo{}, err
+	}
+	st, err := fo.Stat()
+	if err != nil {
+		fo.Close()
+		return 0, udpfs.StatInfo{}, err
+	}
+	h := s.allocHandle(s.newFileHandle(wire.New(fo), true))
+	if h < 0 {
+		fo.Close()
+		return h, udpfs.StatInfo{}, nil
+	}
+	return h, udpfs.StatInfoFromFile(st), nil
+}
+
+// openReadOnly opens a client path for reading: a real file, or an image
+// the server presents virtually (see openVirtual).
+func (s *Backend) openReadOnly(clientPath string) (interfaces.FileObject, error) {
+	fullPath, ok := s.resolvePath(clientPath)
+	if !ok || fullPath == "" || fullPath == virtualRoot {
+		return nil, os.ErrNotExist
+	}
+	if open, readOnly := s.getFileState(fullPath); open && !readOnly {
+		return nil, os.ErrPermission // being written
+	}
+	if st, err := os.Stat(fullPath); err == nil {
+		if st.IsDir() {
+			return nil, os.ErrNotExist
+		}
+		f, err := os.Open(fullPath)
+		if err != nil {
+			return nil, err
+		}
+		return f, nil
+	}
+	if fo := s.openVirtual(fullPath); fo != nil {
+		return fo, nil
+	}
+	return nil, os.ErrNotExist
+}
+
+// openVirtual opens a file that does not exist on the host but stands for
+// an image: <name>.<zso|cso|chd>.iso, the decompressed image. nil if
+// fullPath is none of these.
+func (s *Backend) openVirtual(fullPath string) interfaces.FileObject {
+	if s.enableCompression && strings.EqualFold(filepath.Ext(fullPath), ".iso") {
+		// If path has .iso extension, trim it and probe every supported extension
+		compressedPath := strings.TrimSuffix(fullPath, filepath.Ext(fullPath))
+		if s.pathExists(compressedPath) {
+			log.Printf("fs: decompressing %s\n", compressedPath)
+			if w := compression.Open(compressedPath, s.compressionCacheSize); w != nil {
+				return w
+			}
+		}
+	}
+	return nil
+}
+
+// statVirtual is os.Stat for the files openVirtual opens (nil if none).
+func (s *Backend) statVirtual(fullPath string) os.FileInfo {
+	if s.enableCompression && strings.EqualFold(filepath.Ext(fullPath), ".iso") {
+		if st := compression.GetStat(strings.TrimSuffix(fullPath, filepath.Ext(fullPath))); st != nil {
+			return st
+		}
+	}
+	return nil
+}
diff --git a/internal/fs/wire/wire.go b/internal/fs/wire/wire.go
new file mode 100644
index 0000000..6f43376
--- /dev/null
+++ b/internal/fs/wire/wire.go
@@ -0,0 +1,99 @@
+// Package wire serves a file as LZ4 wire frames (the PSX DESR installer's
+// "/.lz4f" paths): each read of N bytes returns one frame carrying the next
+// raw bytes of the file. Seeks and the size stay in raw bytes.
+//
+// A frame, all little-endian:
+//
+//	u32 magic     Magic ("LZF1")
+//	u32 raw_len   raw bytes it carries
+//	u32 data_len  bytes of data after this header
+//	u32 flags     FlagLZ4: data is one LZ4 block, else raw_len stored bytes
+//	data, zero-padded to a multiple of 16
+//
+// Same format as the installer's src/wire_frame.h.
+package wire
+
+import (
+	"encoding/binary"
+	"io"
+	"os"
+
+	"github.com/pcm720/udpfsd/internal/fs/interfaces"
+	"github.com/pcm720/udpfsd/udpfs"
+	"github.com/pierrec/lz4/v4"
+)
+
+const (
+	Magic      = 0x31465A4C // "LZF1"
+	HeaderSize = 16
+	FlagLZ4    = 1
+	// PathPrefix is the first client path component of a framed file:
+	// "/.lz4f/DVD/x.iso" serves "/DVD/x.iso" as frames.
+	PathPrefix = ".lz4f"
+	unit       = 2048 // raw bytes per frame are whole 2048-byte sectors
+)
+
+// RawFor returns the raw bytes one frame carries for a read of n bytes
+// (0 if n is too small for a header and one sector).
+func RawFor(n int) int {
+	if n <= HeaderSize {
+		return 0
+	}
+	return (n - HeaderSize) / unit * unit
+}
+
+// Reader wraps a file: Read returns frames, everything else is raw.
+type Reader struct {
+	interfaces.FileObject
+	raw  []byte
+	comp []byte
+	c    lz4.Compressor
+}
+
+// New serves inner as frames. Closing the Reader closes inner.
+func New(inner interfaces.FileObject) *Reader { return &Reader{FileObject: inner} }
+
+// Read fills p with one frame for the next RawFor(len(p)) raw bytes (fewer
+// at the end of the file) and returns its size: 0 at EOF, EINVAL if p
+// cannot hold a frame.
+func (r *Reader) Read(p []byte) (int, error) {
+	want := RawFor(len(p))
+	if want == 0 {
+		return 0, udpfs.Errno(-udpfs.EINVAL)
+	}
+	if cap(r.raw) < want {
+		r.raw = make([]byte, want)
+		r.comp = make([]byte, lz4.CompressBlockBound(want))
+	}
+	raw := r.raw[:want]
+	n, err := io.ReadFull(r.FileObject, raw)
+	if err != nil && err != io.EOF && err != io.ErrUnexpectedEOF {
+		return 0, err
+	}
+	if n == 0 {
+		return 0, io.EOF
+	}
+	return Encode(p, raw[:n], &r.c, r.comp), nil
+}
+
+// Encode writes the frame for raw into dst and returns its size
+// (HeaderSize + data padded to 16). dst must hold HeaderSize + len(raw)
+// rounded up to 16; scratch must hold lz4.CompressBlockBound(len(raw)).
+// The frame is stored unless LZ4 makes the data smaller.
+func Encode(dst, raw []byte, c *lz4.Compressor, scratch []byte) int {
+	data, flags := raw, uint32(0)
+	if n, err := c.CompressBlock(raw, scratch); err == nil && n > 0 && n < len(raw) {
+		data, flags = scratch[:n], FlagLZ4
+	}
+	binary.LittleEndian.PutUint32(dst[0:], Magic)
+	binary.LittleEndian.PutUint32(dst[4:], uint32(len(raw)))
+	binary.LittleEndian.PutUint32(dst[8:], uint32(len(data)))
+	binary.LittleEndian.PutUint32(dst[12:], flags)
+	copy(dst[HeaderSize:], data)
+	end := HeaderSize + (len(data)+15)&^15
+	clear(dst[HeaderSize+len(data) : end])
+	return end
+}
+
+// Write: framed files are read-only.
+func (r *Reader) Write([]byte) (int, error) { return 0, os.ErrPermission }
diff --git a/internal/fs/wire/wire_test.go b/internal/fs/wire/wire_test.go
new file mode 100644
index 0000000..a14576b
--- /dev/null
+++ b/internal/fs/wire/wire_test.go
@@ -0,0 +1,210 @@
+package wire
+
+import (
+	"bytes"
+	"encoding/binary"
+	"io"
+	"math/rand"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/pcm720/udpfsd/udpfs"
+	"github.com/pierrec/lz4/v4"
+)
+
+type frame struct {
+	raw          []byte
+	flags, total int
+}
+
+// parse checks one frame against the format and decodes it.
+func parse(t *testing.T, b []byte, n int) frame {
+	t.Helper()
+	if len(b) < HeaderSize || binary.LittleEndian.Uint32(b) != Magic || string(b[:4]) != "LZF1" {
+		t.Fatalf("bad header % x", b[:min(len(b), 16)])
+	}
+	rawLen := int(binary.LittleEndian.Uint32(b[4:]))
+	dataLen := int(binary.LittleEndian.Uint32(b[8:]))
+	flags := int(binary.LittleEndian.Uint32(b[12:]))
+	total := HeaderSize + (dataLen+15)&^15
+	if total != len(b) || total%16 != 0 || total > n {
+		t.Fatalf("frame %d bytes, data %d, read size %d", len(b), dataLen, n)
+	}
+	for _, p := range b[HeaderSize+dataLen:] {
+		if p != 0 {
+			t.Fatal("padding not zero")
+		}
+	}
+	data := b[HeaderSize : HeaderSize+dataLen]
+	switch flags {
+	case FlagLZ4:
+		if dataLen >= rawLen {
+			t.Fatalf("LZ4 frame not smaller: %d >= %d", dataLen, rawLen)
+		}
+		out := make([]byte, rawLen)
+		got, err := lz4.UncompressBlock(data, out)
+		if err != nil || got != rawLen {
+			t.Fatalf("UncompressBlock: %d %v", got, err)
+		}
+		return frame{out, flags, total}
+	case 0:
+		if dataLen != rawLen {
+			t.Fatalf("stored frame data %d != raw %d", dataLen, rawLen)
+		}
+		return frame{append([]byte(nil), data...), flags, total}
+	}
+	t.Fatalf("flags %#x", flags)
+	return frame{}
+}
+
+func open(t *testing.T, data []byte) *Reader {
+	t.Helper()
+	p := filepath.Join(t.TempDir(), "img.iso")
+	if err := os.WriteFile(p, data, 0644); err != nil {
+		t.Fatal(err)
+	}
+	f, err := os.Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	r := New(f)
+	t.Cleanup(func() { r.Close() })
+	return r
+}
+
+// readAll reads frames of n bytes until EOF and returns the raw stream.
+func readAll(t *testing.T, r *Reader, n int, wantFlags int) []byte {
+	t.Helper()
+	var out []byte
+	buf := make([]byte, n)
+	for {
+		got, err := r.Read(buf)
+		if err == io.EOF && got == 0 {
+			return out
+		}
+		if err != nil {
+			t.Fatal(err)
+		}
+		f := parse(t, buf[:got], n)
+		if wantFlags >= 0 && f.flags != wantFlags {
+			t.Fatalf("flags %d, want %d", f.flags, wantFlags)
+		}
+		if len(f.raw) > RawFor(n) {
+			t.Fatalf("raw %d > %d", len(f.raw), RawFor(n))
+		}
+		out = append(out, f.raw...)
+	}
+}
+
+func TestRawFor(t *testing.T) {
+	for n, want := range map[int]int{131072: 129024, 65536: 63488, 2064: 2048, 2063: 0, 16: 0, 0: 0, -5: 0} {
+		if got := RawFor(n); got != want {
+			t.Errorf("RawFor(%d) = %d, want %d", n, got, want)
+		}
+	}
+}
+
+func TestCompressibleRoundTrip(t *testing.T) {
+	data := bytes.Repeat([]byte("PlayStation 2 sector data. "), 20000) // 540000 bytes, not a sector multiple
+	r := open(t, data)
+	if got := readAll(t, r, 131072, FlagLZ4); !bytes.Equal(got, data) {
+		t.Fatalf("round trip: %d bytes, want %d", len(got), len(data))
+	}
+}
+
+func TestRandomDataIsStored(t *testing.T) {
+	data := make([]byte, 300*1024+100)
+	rand.New(rand.NewSource(1)).Read(data)
+	r := open(t, data)
+	if got := readAll(t, r, 131072, 0); !bytes.Equal(got, data) {
+		t.Fatal("stored round trip differs")
+	}
+}
+
+func TestFrameSizesForOddReadSizes(t *testing.T) {
+	data := make([]byte, 200*1024)
+	rng := rand.New(rand.NewSource(2))
+	for i := 0; i < len(data); i += 4096 { // half random, half zero sectors
+		rng.Read(data[i : i+2048])
+	}
+	for _, n := range []int{2064, 2065, 4096, 65536, 100000, 131072} {
+		r := open(t, data)
+		if got := readAll(t, r, n, -1); !bytes.Equal(got, data) {
+			t.Fatalf("read size %d: round trip differs", n)
+		}
+	}
+}
+
+func TestSeekThenRead(t *testing.T) {
+	data := make([]byte, 64*2048)
+	for i := range data {
+		data[i] = byte(i / 2048)
+	}
+	r := open(t, data)
+	if pos, err := r.Seek(0, io.SeekEnd); err != nil || pos != int64(len(data)) {
+		t.Fatalf("SEEK_END = %d %v (raw size)", pos, err)
+	}
+	if st, _ := r.Stat(); st.Size() != int64(len(data)) {
+		t.Fatalf("stat size %d", st.Size())
+	}
+	off := int64(10*2048 + 7)
+	if pos, err := r.Seek(off, io.SeekStart); err != nil || pos != off {
+		t.Fatalf("seek %d %v", pos, err)
+	}
+	buf := make([]byte, 4096+16)
+	n, err := r.Read(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	f := parse(t, buf[:n], len(buf))
+	if !bytes.Equal(f.raw, data[off:off+4096]) {
+		t.Fatal("frame after seek has the wrong bytes")
+	}
+	if pos, _ := r.Seek(0, io.SeekCurrent); pos != off+4096 {
+		t.Fatalf("position %d after one frame, want %d (raw)", pos, off+4096)
+	}
+}
+
+func TestEOF(t *testing.T) {
+	data := bytes.Repeat([]byte{7}, 5000)
+	r := open(t, data)
+	buf := make([]byte, 131072)
+	n, err := r.Read(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if f := parse(t, buf[:n], len(buf)); len(f.raw) != 5000 {
+		t.Fatalf("last frame raw %d", len(f.raw))
+	}
+	for i := 0; i < 2; i++ {
+		if n, err := r.Read(buf); n != 0 || err != io.EOF {
+			t.Fatalf("at EOF: %d %v", n, err)
+		}
+	}
+	r.Seek(4999, io.SeekStart)
+	n, _ = r.Read(buf)
+	if f := parse(t, buf[:n], len(buf)); len(f.raw) != 1 || f.raw[0] != 7 {
+		t.Fatalf("one byte before EOF: %v", f.raw)
+	}
+}
+
+func TestReadTooSmall(t *testing.T) {
+	r := open(t, make([]byte, 8192))
+	for _, n := range []int{0, 1, 16, 17, 2063} {
+		got, err := r.Read(make([]byte, n))
+		if got != 0 || err != udpfs.Errno(-udpfs.EINVAL) {
+			t.Fatalf("read %d: %d %v, want EINVAL", n, got, err)
+		}
+	}
+	if pos, _ := r.Seek(0, io.SeekCurrent); pos != 0 {
+		t.Fatalf("a refused read moved the position to %d", pos)
+	}
+}
+
+func TestReadOnly(t *testing.T) {
+	r := open(t, make([]byte, 10))
+	if _, err := r.Write([]byte("x")); err == nil {
+		t.Fatal("write accepted")
+	}
+}
