index 0000000..a10f7fc
--- /dev/null
+++ b/internal/fs/oplart/oplart_test.go
@@ -0,0 +1,184 @@
+package oplart
+
+import (
+	"bytes"
+	"image"
+	"image/color"
+	"image/jpeg"
+	"image/png"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func picture(w, h int, c color.RGBA) *image.RGBA {
+	img := image.NewRGBA(image.Rect(0, 0, w, h))
+	for y := 0; y < h; y++ {
+		for x := 0; x < w; x++ {
+			img.Set(x, y, c)
+		}
+	}
+	return img
+}
+
+func writeJPEG(t *testing.T, path string, w, h int, c color.RGBA) {
+	t.Helper()
+	var b bytes.Buffer
+	if err := jpeg.Encode(&b, picture(w, h, c), &jpeg.Options{Quality: 95}); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, b.Bytes(), 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func writePNG(t *testing.T, path string, w, h int, c color.RGBA) []byte {
+	t.Helper()
+	var b bytes.Buffer
+	if err := png.Encode(&b, picture(w, h, c)); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, b.Bytes(), 0644); err != nil {
+		t.Fatal(err)
+	}
+	return b.Bytes()
+}
+
+// decodePNG checks b is a PNG of w x h close to c.
+func decodePNG(t *testing.T, b []byte, w, h int, c color.RGBA) {
+	t.Helper()
+	img, format, err := image.Decode(bytes.NewReader(b))
+	if err != nil || format != "png" {
+		t.Fatalf("not a PNG: %s %v", format, err)
+	}
+	if img.Bounds().Dx() != w || img.Bounds().Dy() != h {
+		t.Fatalf("size %v, want %dx%d", img.Bounds(), w, h)
+	}
+	r, g, bl, a := img.At(w/2, h/2).RGBA()
+	near := func(v uint32, want uint8) bool { d := int(v>>8) - int(want); return d > -8 && d < 8 }
+	if !near(r, c.R) || !near(g, c.G) || !near(bl, c.B) || a>>8 != 255 {
+		t.Fatalf("colour %d %d %d %d, want %v", r>>8, g>>8, bl>>8, a>>8, c)
+	}
+}
+
+func TestParse(t *testing.T) {
+	for name, want := range map[string][2]string{
+		"SLUS_200.66_COV.png": {"SLUS_200.66", "COV"}, "SLUS_200.66_COV2.png": {"SLUS_200.66", "COV2"},
+		"SCES_500.51_SCR2.PNG": {"SCES_500.51", "SCR2"}, "SLPM_123.45_bg.png": {"SLPM_123.45", "BG"},
+		"SLUS_200.66_ICO.png": {"SLUS_200.66", "ICO"}, "SLUS_200.66_LAB.png": {"SLUS_200.66", "LAB"},
+		"SLUS_200.66_LGO.png": {"SLUS_200.66", "LGO"}, "SLUS_200.66_SCR.png": {"SLUS_200.66", "SCR"},
+	} {
+		s, x, ok := Parse(name)
+		if !ok || s != want[0] || x != want[1] {
+			t.Errorf("Parse(%q) = %q %q %v", name, s, x, ok)
+		}
+	}
+	for _, name := range []string{"SLUS_200.66_COV.jpg", "SLUS_200.66_BG_00.png", "SLUS_200.66_XYZ.png", "_COV.png",
+		"SLUS_200.66.png", "../x_COV.png", "a/b_COV.png", "SLUS_200.66_SCR_01.png"} {
+		if _, _, ok := Parse(name); ok {
+			t.Errorf("Parse(%q) accepted", name)
+		}
+	}
+}
+
+func TestPNGUnchangedJPEGConverted(t *testing.T) {
+	dir := t.TempDir()
+	cov := writePNG(t, filepath.Join(dir, "SLUS_200.66_COV.png"), 14, 20, color.RGBA{200, 10, 10, 255})
+	writeJPEG(t, filepath.Join(dir, "SLUS_200.66_COV2.jpg"), 16, 24, color.RGBA{10, 200, 10, 255})
+	writeJPEG(t, filepath.Join(dir, "SLUS_200.66_BG_00.jpg"), 64, 48, color.RGBA{10, 10, 200, 255})
+	writePNG(t, filepath.Join(dir, "SLUS_200.66_SCR_00.png"), 32, 24, color.RGBA{50, 50, 50, 255})
+	writeJPEG(t, filepath.Join(dir, "SLUS_200.66_SCR_01.jpeg"), 32, 24, color.RGBA{250, 250, 0, 255})
+	writeJPEG(t, filepath.Join(dir, "slus_200.66_ico.JPG"), 8, 8, color.RGBA{0, 250, 250, 255})
+	writeJPEG(t, filepath.Join(dir, "SLUS_200.66_LGO.png"), 8, 8, color.RGBA{250, 0, 250, 255}) // a JPEG named .png
+	s := New(dir)
+
+	b, _, err := s.Get("SLUS_200.66_COV.png")
+	if err != nil || !bytes.Equal(b, cov) {
+		t.Fatalf("PNG not served unchanged: %v", err)
+	}
+	for name, want := range map[string]struct {
+		w, h int
+		c    color.RGBA
+	}{
+		"SLUS_200.66_COV2.png": {16, 24, color.RGBA{10, 200, 10, 255}},
+		"SLUS_200.66_BG.png":   {64, 48, color.RGBA{10, 10, 200, 255}}, // <- BG_00.jpg
+		"SLUS_200.66_SCR.png":  {32, 24, color.RGBA{50, 50, 50, 255}},  // <- SCR_00.png
+		"SLUS_200.66_SCR2.png": {32, 24, color.RGBA{250, 250, 0, 255}}, // <- SCR_01.jpeg
+		"SLUS_200.66_ICO.png":  {8, 8, color.RGBA{0, 250, 250, 255}},   // letter case
+		"SLUS_200.66_LGO.png":  {8, 8, color.RGBA{250, 0, 250, 255}},   // content, not extension
+		"slus_200.66_cov2.PNG": {16, 24, color.RGBA{10, 200, 10, 255}}, // request case
+	} {
+		b, _, err := s.Get(name)
+		if err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		decodePNG(t, b, want.w, want.h, want.c)
+		st, err := s.Stat(name)
+		if err != nil || st.Size() != int64(len(b)) {
+			t.Fatalf("%s: stat %v %v, want the PNG size %d", name, st, err, len(b))
+		}
+		f, err := s.Open(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		got := make([]byte, len(b)+10)
+		n, _ := f.Read(got)
+		if n != len(b) || !bytes.Equal(got[:n], b) {
+			t.Fatalf("%s: open/read %d bytes", name, n)
+		}
+		if _, err := f.Write([]byte("x")); err == nil {
+			t.Fatal("write accepted")
+		}
+		f.Close()
+	}
+	for _, name := range []string{"SLUS_200.66_LAB.png", "SLUS_999.99_COV.png", "SLUS_200.66_XYZ.png", "SLUS_200.66_COV.jpg"} {
+		if _, _, err := s.Get(name); !os.IsNotExist(err) {
+			t.Fatalf("%s: %v", name, err)
+		}
+	}
+	if _, _, err := New("").Get("SLUS_200.66_COV.png"); !os.IsNotExist(err) {
+		t.Fatal("art without an art folder")
+	}
+}
+
+func TestPreferenceAndCache(t *testing.T) {
+	dir := t.TempDir()
+	writeJPEG(t, filepath.Join(dir, "X_BG_00.jpg"), 4, 4, color.RGBA{0, 0, 255, 255})
+	s := New(dir)
+	b1, _, err := s.Get("X_BG.png")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if b2, _, _ := s.Get("X_BG.png"); &b1[0] != &b2[0] {
+		t.Fatal("converted art not cached")
+	}
+	// BG wins over BG_00; PNG over JPEG for the same name.
+	writeJPEG(t, filepath.Join(dir, "X_BG.jpg"), 6, 6, color.RGBA{255, 0, 0, 255})
+	b, _, _ := s.Get("X_BG.png")
+	decodePNG(t, b, 6, 6, color.RGBA{255, 0, 0, 255})
+	writePNG(t, filepath.Join(dir, "X_BG.png"), 2, 2, color.RGBA{0, 255, 0, 255})
+	b, _, _ = s.Get("X_BG.png")
+	decodePNG(t, b, 2, 2, color.RGBA{0, 255, 0, 255})
+	// A changed source is converted again (cache key: path, time, size).
+	p := filepath.Join(dir, "X_BG.jpg")
+	os.Remove(filepath.Join(dir, "X_BG.png"))
+	writeJPEG(t, p, 10, 10, color.RGBA{255, 255, 255, 255})
+	os.Chtimes(p, time.Now().Add(time.Hour), time.Now().Add(time.Hour))
+	b, _, _ = s.Get("X_BG.png")
+	decodePNG(t, b, 10, 10, color.RGBA{255, 255, 255, 255})
+}
+
+func TestCacheBounded(t *testing.T) {
+	s := New(t.TempDir())
+	s.maxBytes = 100
+	for i := 0; i < 5; i++ {
+		s.put(key{path: string(rune('a' + i))}, make([]byte, 40))
+	}
+	if s.bytes > 100 || len(s.cache) != 2 || len(s.order) != 2 {
+		t.Fatalf("cache %d bytes, %d entries", s.bytes, len(s.cache))
+	}
+	if _, ok := s.cache[key{path: "e"}]; !ok {
+		t.Fatal("newest entry evicted")
+	}
+}
diff --git a/internal/fs/oplart_backend_test.go b/internal/fs/oplart_backend_test.go
new file mode 100644
index 0000000..2a7f0cf
--- /dev/null
+++ b/internal/fs/oplart_backend_test.go
@@ -0,0 +1,93 @@
+package fs
+
+import (
+	"bytes"
+	"image"
+	"image/color"
+	"image/jpeg"
+	"os"
+	"path/filepath"
+	"slices"
+	"testing"
+
+	"github.com/pcm720/udpfsd/internal/fs/oplart"
+	"github.com/pcm720/udpfsd/udpfs"
+)
+
+func TestOPLArtFolder(t *testing.T) {
+	art := t.TempDir()
+	img := image.NewRGBA(image.Rect(0, 0, 20, 30))
+	for i := range img.Pix {
+		img.Pix[i] = 0x80
+	}
+	img.Set(0, 0, color.RGBA{255, 0, 0, 255})
+	var jb bytes.Buffer
+	jpeg.Encode(&jb, img, nil)
+	mkfile(t, filepath.Join(art, "SLUS_200.66_COV.jpg"), jb.String())
+	want, _, err := oplart.New(art).Get("SLUS_200.66_COV.png")
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := NewBackend(WithMount("ART", art), WithOPLArt(art), WithReadOnly())
+	if err != nil {
+		t.Fatal(err)
+	}
+	const p = "/.oplart/SLUS_200.66_COV.png"
+	if st, err := b.Getstat(p); err != nil || int(st.Size) != len(want) || st.Mode != udpfs.FIO_S_IFREG {
+		t.Fatalf("getstat %+v %v, want size %d", st, err, len(want))
+	}
+	h, st, err := b.Open(p, os.O_RDONLY, false)
+	if err != nil || int(st.Size) != len(want) {
+		t.Fatalf("open %d %v", st.Size, err)
+	}
+	n, got, err := b.Read(h, 128*1024, make([]byte, 128*1024))
+	if err != nil || int(n) != len(want) || !bytes.Equal(got, want) {
+		t.Fatalf("read %d %v", n, err)
+	}
+	if _, f, err := image.Decode(bytes.NewReader(got)); err != nil || f != "png" {
+		t.Fatalf("served %s %v", f, err)
+	}
+	if st, err := b.Getstat(p); err != nil || int(st.Size) != len(want) {
+		t.Fatalf("getstat while open %d %v", st.Size, err)
+	}
+	b.Close(h)
+
+	h, _, err = b.Open("/.lz4f"+p, os.O_RDONLY, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := readFrames(t, b, h, 4096); !bytes.Equal(got, want) {
+		t.Fatal("framed art differs")
+	}
+	b.Close(h)
+
+	for _, bad := range []string{"/.oplart/SLUS_200.66_LAB.png", "/.oplart/SLUS_200.66_COV.jpg", "/.oplart/x/SLUS_200.66_COV.png", "/.oplart/../ART/SLUS_200.66_COV.jpg"} {
+		if _, _, err := b.Open(bad, os.O_RDONLY, false); !os.IsNotExist(err) {
+			t.Fatalf("%s: %v", bad, err)
+		}
+		if _, err := b.Getstat(bad); err == nil {
+			t.Fatalf("%s: getstat succeeded", bad)
+		}
+	}
+	if _, _, err := b.Open(p, os.O_RDWR, false); !os.IsPermission(err) {
+		t.Fatalf("art opened for writing: %v", err)
+	}
+	if got := listDir(t, b, "/.oplart"); len(got) != 0 {
+		t.Fatalf("/.oplart lists %v", got)
+	}
+	if st, err := b.Getstat("/.oplart"); err != nil || st.Mode != udpfs.FIO_S_IFDIR {
+		t.Fatalf("getstat folder %+v %v", st, err)
+	}
+	if names := listDir(t, b, "/"); slices.Contains(names, oplart.PathPrefix) || !eq(names, []string{"ART"}) {
+		t.Fatalf("root lists %v", names)
+	}
+
+	// Without an art folder nothing is found.
+	nb, err := NewBackend(WithMount("ART", art), WithReadOnly())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, _, err := nb.Open(p, os.O_RDONLY, false); !os.IsNotExist(err) {
+		t.Fatalf("art without WithOPLArt: %v", err)
+	}
+}
