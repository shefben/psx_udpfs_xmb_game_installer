diff --git a/internal/fs/oplart.go b/internal/fs/oplart.go
new file mode 100644
index 0000000..22b6c46
--- /dev/null
+++ b/internal/fs/oplart.go
@@ -0,0 +1,76 @@
+package fs
+
+import (
+	"os"
+	"strings"
+
+	"github.com/pcm720/udpfsd/internal/fs/oplart"
+	"github.com/pcm720/udpfsd/udpfs"
+)
+
+// WithOPLArt serves the art folder (udpfsd.cfg "art") as Open PS2 Loader
+// reads art: /.oplart/<STARTUP>_<SUFFIX>.png, always PNG.
+func WithOPLArt(artDir string) func(s *Backend) {
+	return func(s *Backend) {
+		s.art = oplart.New(artDir)
+	}
+}
+
+// oplArt is the art server; without an art folder it finds nothing.
+func (s *Backend) oplArt() *oplart.Server {
+	if s.art == nil {
+		return noArt
+	}
+	return s.art
+}
+
+var noArt = oplart.New("")
+
+// artName returns the file name in "/.oplart/<name>" ("" for the folder),
+// ok=false for deeper paths.
+func artName(rest string) (string, bool) {
+	name := strings.TrimPrefix(rest, "/")
+	return name, !strings.Contains(name, "/")
+}
+
+// openOPLArt opens "/.oplart" (an empty, read-only folder) or an art file
+// in it.
+func (s *Backend) openOPLArt(rest string, flag int, isDir bool) (int32, udpfs.StatInfo, error) {
+	if flag&writeFlags != 0 {
+		return 0, udpfs.StatInfo{}, os.ErrPermission
+	}
+	name, ok := artName(rest)
+	if !ok || isDir != (name == "") {
+		return 0, udpfs.StatInfo{}, os.ErrNotExist
+	}
+	if isDir {
+		h := s.allocHandle(&dirHandle{dirPath: "\x00" + oplart.PathPrefix})
+		return h, udpfs.StatInfo{Mode: udpfs.FIO_S_IFDIR}, nil
+	}
+	f, err := s.oplArt().Open(name)
+	if err != nil {
+		return 0, udpfs.StatInfo{}, os.ErrNotExist
+	}
+	st, _ := f.Stat()
+	h := s.allocHandle(s.newFileHandle(f, true))
+	if h < 0 {
+		return h, udpfs.StatInfo{}, nil
+	}
+	return h, udpfs.StatInfoFromFile(st), nil
+}
+
+// statOPLArt is Getstat for "/.oplart" and the art files in it.
+func (s *Backend) statOPLArt(rest string) (udpfs.StatInfo, error) {
+	name, ok := artName(rest)
+	if !ok {
+		return udpfs.StatInfo{}, os.ErrNotExist
+	}
+	if name == "" {
+		return udpfs.StatInfo{Mode: udpfs.FIO_S_IFDIR}, nil
+	}
+	st, err := s.oplArt().Stat(name)
+	if err != nil {
+		return udpfs.StatInfo{}, os.ErrNotExist
+	}
+	return udpfs.StatInfoFromFile(st), nil
+}
diff --git a/internal/fs/oplart/oplart.go b/internal/fs/oplart/oplart.go
new file mode 100644
index 0000000..556b37b
--- /dev/null
+++ b/internal/fs/oplart/oplart.go
@@ -0,0 +1,218 @@
+// Package oplart serves a game art folder (the "art" folder, /ART) the way
+// Open PS2 Loader reads it: OPL loads only PNG files named
+// <STARTUP>_<SUFFIX>.png. "/.oplart/<STARTUP>_<SUFFIX>.png" returns the
+// art for that name: a PNG as it is, a JPEG converted to PNG.
+package oplart
+
+import (
+	"bytes"
+	"image"
+	"image/draw"
+	"image/jpeg"
+	"image/png"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/pcm720/udpfsd/internal/fs/compression/common"
+)
+
+// PathPrefix is the first client path component of the art folder.
+const PathPrefix = ".oplart"
+
+// sources lists, per OPL suffix, the art names it is made from, in order.
+var sources = map[string][]string{
+	"COV":  {"COV"},
+	"COV2": {"COV2"},
+	"ICO":  {"ICO"},
+	"LAB":  {"LAB"},
+	"LGO":  {"LGO"},
+	"BG":   {"BG", "BG_00"},
+	"SCR":  {"SCR", "SCR_00"},
+	"SCR2": {"SCR2", "SCR_01"},
+}
+
+var exts = []string{".png", ".jpg", ".jpeg"}
+
+var pngMagic = []byte("\x89PNG\r\n\x1a\n")
+
+// maxSource: art files are small; a bigger file is not served.
+const maxSource = 32 << 20
+
+// Parse splits an OPL art file name "<STARTUP>_<SUFFIX>.png" (case of the
+// suffix and extension ignored). ok is false for anything OPL never asks.
+func Parse(name string) (startup, suffix string, ok bool) {
+	if !strings.EqualFold(filepath.Ext(name), ".png") {
+		return "", "", false
+	}
+	stem := strings.TrimSuffix(name, filepath.Ext(name))
+	i := strings.LastIndexByte(stem, '_')
+	if i <= 0 {
+		return "", "", false
+	}
+	startup, suffix = stem[:i], strings.ToUpper(stem[i+1:])
+	if _, known := sources[suffix]; !known || strings.ContainsAny(startup, `/\:`) || startup == "." || startup == ".." {
+		return "", "", false
+	}
+	return startup, suffix, true
+}
+
+type key struct {
+	path string
+	mod  time.Time
+	size int64
+}
+
+// Server finds and converts art in one folder, caching converted JPEGs.
+type Server struct {
+	dir string
+
+	mu       sync.Mutex
+	cache    map[key][]byte
+	order    []key
+	bytes    int
+	maxBytes int
+}
+
+// New serves the art in dir ("" = no art folder: nothing is found).
+func New(dir string) *Server {
+	return &Server{dir: dir, cache: map[key][]byte{}, maxBytes: 64 << 20}
+}
+
+// find returns the source file for name, looking up each candidate name
+// with each extension; letter case does not matter.
+func (s *Server) find(startup, suffix string) (string, os.FileInfo, error) {
+	if s.dir == "" {
+		return "", nil, os.ErrNotExist
+	}
+	var listing []os.DirEntry
+	listed := false
+	for _, src := range sources[suffix] {
+		for _, ext := range exts {
+			want := startup + "_" + src + ext
+			for _, n := range []string{want, startup + "_" + src + strings.ToUpper(ext)} {
+				p := filepath.Join(s.dir, n)
+				if st, err := os.Stat(p); err == nil && st.Mode().IsRegular() {
+					return p, st, nil
+				}
+			}
+			if !listed {
+				listing, _ = os.ReadDir(s.dir)
+				listed = true
+			}
+			for _, e := range listing {
+				if strings.EqualFold(e.Name(), want) && e.Type().IsRegular() {
+					p := filepath.Join(s.dir, e.Name())
+					if st, err := os.Stat(p); err == nil {
+						return p, st, nil
+					}
+				}
+			}
+		}
+	}
+	return "", nil, os.ErrNotExist
+}
+
+// Get returns the PNG for an OPL art file name, and the time of its source.
+func (s *Server) Get(name string) ([]byte, time.Time, error) {
+	startup, suffix, ok := Parse(name)
+	if !ok {
+		return nil, time.Time{}, os.ErrNotExist
+	}
+	p, st, err := s.find(startup, suffix)
+	if err != nil {
+		return nil, time.Time{}, err
+	}
+	if st.Size() > maxSource {
+		return nil, time.Time{}, os.ErrNotExist
+	}
+	k := key{p, st.ModTime(), st.Size()}
+	s.mu.Lock()
+	b, hit := s.cache[k]
+	s.mu.Unlock()
+	if hit {
+		return b, st.ModTime(), nil
+	}
+	raw, err := os.ReadFile(p)
+	if err != nil {
+		return nil, time.Time{}, err
+	}
+	if bytes.HasPrefix(raw, pngMagic) {
+		return raw, st.ModTime(), nil // PNG: unchanged (read again each time: no copy kept)
+	}
+	b, err = toPNG(raw)
+	if err != nil {
+		return nil, time.Time{}, os.ErrNotExist
+	}
+	s.put(k, b)
+	return b, st.ModTime(), nil
+}
+
+// toPNG converts a JPEG to an opaque 8-bit RGB PNG.
+func toPNG(raw []byte) ([]byte, error) {
+	img, err := jpeg.Decode(bytes.NewReader(raw))
+	if err != nil {
+		return nil, err
+	}
+	rgba := image.NewRGBA(img.Bounds())
+	draw.Draw(rgba, rgba.Bounds(), img, img.Bounds().Min, draw.Src)
+	var out bytes.Buffer
+	if err := png.Encode(&out, rgba); err != nil {
+		return nil, err
+	}
+	return out.Bytes(), nil
+}
+
+func (s *Server) put(k key, b []byte) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if _, ok := s.cache[k]; ok || len(b) > s.maxBytes {
+		return
+	}
+	for s.bytes+len(b) > s.maxBytes && len(s.order) > 0 {
+		old := s.order[0]
+		s.order = s.order[1:]
+		s.bytes -= len(s.cache[old])
+		delete(s.cache, old)
+	}
+	s.cache[k] = b
+	s.order = append(s.order, k)
+	s.bytes += len(b)
+}
+
+// Stat returns the stat of the art file name (its PNG size).
+func (s *Server) Stat(name string) (os.FileInfo, error) {
+	b, mt, err := s.Get(name)
+	if err != nil {
+		return nil, err
+	}
+	return common.NewCompressedInfo(name, int64(len(b)), mt), nil
+}
+
+// Open returns the art file name as a read-only file.
+func (s *Server) Open(name string) (*File, error) {
+	b, mt, err := s.Get(name)
+	if err != nil {
+		return nil, err
+	}
+	return &File{Reader: bytes.NewReader(b), name: "\x00" + PathPrefix + "/" + name,
+		info: common.NewCompressedInfo(name, int64(len(b)), mt)}, nil
+}
+
+// File is one served art file (interfaces.FileObject).
+type File struct {
+	*bytes.Reader
+	name string
+	info os.FileInfo
+}
+
+// Write: the art folder is read-only.
+func (f *File) Write([]byte) (int, error) { return 0, os.ErrPermission }
+
+func (f *File) Stat() (os.FileInfo, error) { return f.info, nil }
+
+// Name is a marker that no host path can equal.
+func (f *File) Name() string { return f.name }
+func (f *File) Close() error { return nil }
diff --git a/internal/fs/oplart/oplart_test.go b/internal/fs/oplart/oplart_test.go
