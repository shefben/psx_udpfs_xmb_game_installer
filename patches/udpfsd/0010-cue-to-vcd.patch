+// cueEntries lists each cue sheet that cue2pops accepts as its VCD
+// (Game.cue -> Game.VCD, with the VCD's size). A real Game.VCD wins; the
+// BIN stays listed.
+func cueEntries(dir string, entries []os.DirEntry) []os.DirEntry {
+	present := map[string]bool{}
+	for _, e := range entries {
+		present[foldName(e.Name())] = true
+	}
+	out := make([]os.DirEntry, 0, len(entries))
+	changed := false
+	for _, e := range entries {
+		name := e.Name()
+		if strings.EqualFold(filepath.Ext(name), ".cue") && e.Type().IsRegular() && !present[foldName(vcd.VCDName(name))] {
+			if img, err := vcd.Load(filepath.Join(dir, name)); err == nil {
+				out = append(out, virtualEntry{img.Info(vcd.VCDName(name))})
+				changed = true
+				continue
+			}
+		}
+		out = append(out, e)
+	}
+	if changed {
+		sort.Slice(out, func(i, j int) bool { return out[i].Name() < out[j].Name() })
+	}
+	return out
+}
