+
+func TestRejectedCues(t *testing.T) {
+	for name, cue := range rejected {
+		if _, err := Build([]byte(cue), func(string) (int64, error) { return 1 << 20, nil }); !errors.Is(err, ErrRejected) {
+			t.Errorf("%s: accepted (%v)", name, err)
+		}
+	}
