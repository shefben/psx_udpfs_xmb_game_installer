+// binData is a recognisable BIN: every byte depends on its offset.
+func binData(n int) []byte {
+	b := make([]byte, n)
+	for i := range b {
+		b[i] = byte(i ^ i>>8 ^ i>>16)
+	}
+	return b
+}
+
+// header returns a HeaderSize header with the given non-zero bytes.
+func header(set map[int]byte) []byte {
+	h := make([]byte, HeaderSize)
+	for o, v := range set {
+		h[o] = v
+	}
+	return h
+}
+
+func build(t *testing.T, cue string, binSize int64) *Layout {
+	t.Helper()
+	l, err := Build([]byte(cue), func(string) (int64, error) { return binSize, nil })
+	if err != nil {
+		t.Fatal(err)
+	}
+	return l
+}
+
+func checkHeader(t *testing.T, got, want []byte) {
+	t.Helper()
+	for i := range want {
+		if got[i] != want[i] {
+			t.Fatalf("header byte %#x = %#02x, want %#02x", i, got[i], want[i])
+		}
+	}
+}
+
+// image returns the whole VCD of l for bin.
+func image(t *testing.T, l *Layout, bin []byte) []byte {
+	t.Helper()
+	out := make([]byte, l.Size)
+	if n, err := l.ReadAt(out, 0, bytes.NewReader(bin)); n != len(out) || (err != nil && err != io.EOF) {
+		t.Fatalf("ReadAt: %d %v", n, err)
+	}
+	return out
+}
+
+const cueOneTrack = "FILE \"G.bin\" BINARY\r\n  TRACK 01 MODE2/2352\r\n    INDEX 01 00:00:00\r\n"
+
+func TestOneTrack(t *testing.T) {
+	bin := binData(100 * SectorSize)
+	l := build(t, cueOneTrack, int64(len(bin)))
+	if l.BinName != "G.bin" {
+		t.Fatalf("bin name %q", l.BinName)
+	}
+	checkHeader(t, l.Header, header(map[int]byte{
+		0x00: 0x41, 0x02: 0xA0, 0x07: 0x01, 0x08: 0x20, // A0
+		0x0A: 0x41, 0x0C: 0xA1, 0x11: 0x01, // A1: data only, last track 01
+		0x14: 0x41, 0x16: 0xA2, 0x1B: 0x00, 0x1C: 0x03, 0x1D: 0x25, // A2: lead-out 00:03:25 (250 sectors)
+		0x1E: 0x41, 0x20: 0x01, 0x21: 0x00, 0x22: 0x00, 0x23: 0x00, 0x25: 0x00, 0x26: 0x02, 0x27: 0x00, // track 01: 00:00:00 / 00:02:00
+		0x400: 'k', 0x401: 'H', 0x402: 'n', 0x403: 0x20,
+		0x408: 100, 0x40C: 100, // sectors
+	}))
+	if l.Size != HeaderSize+int64(len(bin)) {
+		t.Fatalf("size %d", l.Size)
+	}
+	if img := image(t, l, bin); !bytes.Equal(img[HeaderSize:], bin) || !bytes.Equal(img[:HeaderSize], l.Header) {
+		t.Fatal("image is not header + BIN")
+	}
+}
+
+const cueAudio = `FILE "Game (USA).bin" BINARY
+  TRACK 01 MODE2/2352
+    INDEX 01 00:00:00
+  TRACK 02 AUDIO
+    INDEX 00 00:06:00
+    INDEX 01 00:08:00
+  TRACK 03 AUDIO
+    INDEX 00 00:48:10
+    INDEX 01 09:59:74
+`
+
+func TestDataAndTwoAudioTracks(t *testing.T) {
+	bin := binData(1000 * SectorSize)
+	l := build(t, cueAudio, int64(len(bin)))
+	checkHeader(t, l.Header, header(map[int]byte{
+		0x00: 0x41, 0x02: 0xA0, 0x07: 0x01, 0x08: 0x20,
+		0x0A: 0x01, 0x0C: 0xA1, 0x11: 0x03, // last track is audio, number 03
+		0x14: 0x01, 0x16: 0xA2, 0x1B: 0x00, 0x1C: 0x15, 0x1D: 0x25, // lead-out 00:15:25 (1150 sectors)
+		0x1E: 0x41, 0x20: 0x01, 0x26: 0x02, // track 01
+		// track 02: INDEX 00 00:06:00 +2 s = 00:08:00, INDEX 01 00:08:00 +2 s = 00:10:00
+		0x28: 0x01, 0x2A: 0x02, 0x2B: 0x00, 0x2C: 0x08, 0x2D: 0x00, 0x2F: 0x00, 0x30: 0x10, 0x31: 0x00,
+		// track 03: 00:48:10 -> 00:50:10; 09:59:74 -> 11:01:74 (cue2pops' minute carry quirk)
+		0x32: 0x01, 0x34: 0x03, 0x35: 0x00, 0x36: 0x50, 0x37: 0x10, 0x39: 0x11, 0x3A: 0x01, 0x3B: 0x74,
+		0x400: 'k', 0x401: 'H', 0x402: 'n', 0x403: 0x20,
+		0x408: 0xE8, 0x409: 0x03, 0x40C: 0xE8, 0x40D: 0x03, // 1000 sectors
+	}))
+	if l.BinName != "Game (USA).bin" || l.Size != HeaderSize+int64(len(bin)) {
+		t.Fatalf("%q %d", l.BinName, l.Size)
+	}
+}
+
+const cueCDRWIN = "FILE \"C.bin\" BINARY\n TRACK 01 MODE2/2352\n  INDEX 01 00:00:00\n TRACK 02 AUDIO\n  PREGAP 00:02:00\n  INDEX 01 00:10:00\n"
+
+func TestCDRWINPregapInserted(t *testing.T) {
+	bin := binData(1000 * SectorSize)
+	l := build(t, cueCDRWIN, int64(len(bin)))
+	checkHeader(t, l.Header, header(map[int]byte{
+		0x00: 0x41, 0x02: 0xA0, 0x07: 0x01, 0x08: 0x20,
+		0x0A: 0x01, 0x0C: 0xA1, 0x11: 0x02,
+		0x14: 0x01, 0x16: 0xA2, 0x1B: 0x00, 0x1C: 0x17, 0x1D: 0x25, // 1000+150+150 = 1300 sectors
+		0x1E: 0x41, 0x20: 0x01, 0x26: 0x02,
+		// track 02: 00:10:00 +2 s +2 s (CDRWIN) = 00:14:00, both indexes
+		0x28: 0x01, 0x2A: 0x02, 0x2C: 0x14, 0x30: 0x14,
+		0x400: 'k', 0x401: 'H', 0x402: 'n', 0x403: 0x20,
+		0x408: 0x7E, 0x409: 0x04, 0x40C: 0x7E, 0x40D: 0x04, // 1150 sectors
+	}))
+	gap := int64(150 * SectorSize)
+	at := int64(750 * SectorSize) // track 02 INDEX 01: 00:10:00
+	if l.Size != HeaderSize+int64(len(bin))+gap {
+		t.Fatalf("size %d", l.Size)
+	}
+	img := image(t, l, bin)[HeaderSize:]
+	if !bytes.Equal(img[:at], bin[:at]) || !bytes.Equal(img[at:at+gap], make([]byte, gap)) || !bytes.Equal(img[at+gap:], bin[at:]) {
+		t.Fatal("pregap not inserted at the audio track")
+	}
+}
+
+// A CDRWIN gap in the BIN's last MiB: cue2pops' second fread comes up short
+// and it writes the rest of its buffer as it was (here the previous MiB).
+func TestCDRWINInLastChunkKeepsStaleBuffer(t *testing.T) {
+	cue := strings.Replace(cueCDRWIN, "00:10:00", "00:06:00", 1) // 450 sectors
+	bin := binData(500 * SectorSize)
+	l := build(t, cue, int64(len(bin)))
+	at := int64(450 * SectorSize)
+	short := int64(len(bin)) - at                                          // real bytes after the gap
+	second := HeaderSize - (at - HeaderSize)                               // bytes cue2pops writes after the gap
+	if want := HeaderSize + at + 150*SectorSize + second; l.Size != want { // not BIN + gap
+		t.Fatalf("size %d, want %d", l.Size, want)
+	}
+	img := image(t, l, bin)[HeaderSize:]
+	tail := img[at+150*SectorSize:]
+	if !bytes.Equal(img[:at], bin[:at]) || !bytes.Equal(tail[:short], bin[at:]) ||
+		!bytes.Equal(tail[short:], bin[short:second]) {
+		t.Fatal("stale buffer bytes differ")
+	}
+}
+
+func TestReadAcrossHeaderAndGaps(t *testing.T) {
+	dir := t.TempDir()
+	bin := binData(1000 * SectorSize)
+	os.WriteFile(filepath.Join(dir, "c.bin"), bin, 0644)
+	os.WriteFile(filepath.Join(dir, "C.cue"), []byte(strings.Replace(cueCDRWIN, "C.bin", "C.BIN", 1)), 0644)
+	cue, ok := FindCue(filepath.Join(dir, "C.VCD"))
+	if !ok {
+		t.Fatal("cue not found")
+	}
+	f, err := Open(cue, filepath.Join(dir, "C.VCD")) // BIN name matched loosely
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	l := build(t, cueCDRWIN, int64(len(bin)))
+	want := image(t, l, bin)
+	if st, _ := f.Stat(); st.Size() != int64(len(want)) || st.Name() != "C.VCD" {
+		t.Fatalf("stat %s %d", st.Name(), st.Size())
+	}
+	at := int64(HeaderSize + 750*SectorSize)
+	for _, c := range []struct{ off, n int64 }{
+		{0, 64}, {HeaderSize - 10, 20}, {HeaderSize - 1, 3 * SectorSize}, {at - 5, 10},
+		{at + 150*SectorSize - 7, 14}, {at - 100, 150*SectorSize + 200}, {int64(len(want)) - 9, 9}, {HeaderSize, 2 << 20},
+	} {
+		if _, err := f.Seek(c.off, io.SeekStart); err != nil {
+			t.Fatal(err)
+		}
+		got := make([]byte, c.n)
+		if _, err := io.ReadFull(f, got); err != nil || !bytes.Equal(got, want[c.off:c.off+c.n]) {
+			t.Fatalf("read %d at %#x: %v", c.n, c.off, err)
+		}
+	}
+	if pos, _ := f.Seek(0, io.SeekEnd); pos != int64(len(want)) {
+		t.Fatalf("SEEK_END %d", pos)
+	}
+	if n, err := f.Read(make([]byte, 10)); n != 0 || err != io.EOF {
+		t.Fatalf("at EOF: %d %v", n, err)
+	}
+	if _, err := f.Write([]byte{1}); err == nil {
+		t.Fatal("write accepted")
+	}
+}
+
+var rejected = map[string]string{
+	"two files":       "FILE \"a.bin\" BINARY\nTRACK 01 MODE2/2352\nINDEX 01 00:00:00\nFILE \"b.bin\" BINARY\nTRACK 02 AUDIO\nINDEX 01 00:00:00\n",
+	"wave audio":      "FILE \"a.bin\" BINARY\nTRACK 01 MODE2/2352\nINDEX 01 00:00:00\nFILE \"b.wav\" WAVE\nTRACK 02 AUDIO\nINDEX 01 00:00:00\n",
+	"mode1":           "FILE \"a.bin\" BINARY\nTRACK 01 MODE1/2352\nINDEX 01 00:00:00\n",
+	"track 1":         "FILE \"a.bin\" BINARY\nTRACK 1 MODE2/2352\nINDEX 01 00:00:00\n",
