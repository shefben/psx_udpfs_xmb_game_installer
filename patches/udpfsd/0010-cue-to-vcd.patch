+
+// TestMatchesCue2pops compares Build with the original cue2pops v2.0 when
+// CUE2POPS names a build of it (cue2pops.c, unmodified): byte for byte on
+// accepted cues, and both reject the rejected ones.
+func TestMatchesCue2pops(t *testing.T) {
+	tool := os.Getenv("CUE2POPS")
+	if tool == "" {
+		t.Skip("set CUE2POPS to a cue2pops v2.0 binary to compare")
+	}
+	type tc struct {
+		cue     string
+		sectors int
+	}
+	cases := map[string]tc{
+		"one track":       {cueOneTrack, 100},
+		"audio":           {cueAudio, 1000},
+		"cdrwin":          {cueCDRWIN, 1000},
+		"cdrwin-last-mib": {strings.Replace(cueCDRWIN, "00:10:00", "00:06:00", 1), 500},
+		"cdrwin-boundary": {strings.Replace(cueCDRWIN, "00:10:00", "00:05:71", 1), 1200}, // 446 sectors: 1 MiB = 445.8 sectors
+		"cdrwin-index00":  {strings.Replace(cueCDRWIN, "  PREGAP 00:02:00\n", "  PREGAP 00:02:00\n  INDEX 00 00:09:00\n", 1), 900},
+		"big":             {"FILE \"B.bin\" BINARY\r\n  TRACK 01 MODE2/2352\r\n    INDEX 01 00:00:00\r\n  TRACK 02 AUDIO\r\n    INDEX 00 01:58:70\r\n    INDEX 01 02:00:70\r\n  TRACK 03 AUDIO\r\n    INDEX 00 19:59:00\r\n    INDEX 01 19:59:50\r\n", 10000},
+		"postgap":         {"FILE \"P.bin\" BINARY\n TRACK 01 MODE2/2352\n  INDEX 01 00:00:00\n  POSTGAP 00:02:00\n TRACK 02 AUDIO\n  PREGAP 00:02:00\n  INDEX 01 00:04:00\n", 400},
+		"data only gap":   {"FILE \"D.bin\" BINARY\n TRACK 01 MODE2/2352\n  INDEX 01 00:00:00\n PREGAP 00:02:00\n", 600},
+		"odd size":        {cueOneTrack, 0},
+		"rem lines":       {"\xEF\xBB\xBFREM GENRE \"Platform\"\r\nREM DATE 1997\r\nCATALOG 0000000000000\r\nFILE \"R.bin\" BINARY\r\n  TRACK 01 MODE2/2352\r\n    FLAGS DCP\r\n    INDEX 00 00:00:00\r\n    INDEX 01 00:02:00\r\n  TRACK 02 AUDIO\r\n    FLAGS DCP\r\n    INDEX 00 03:10:22\r\n    INDEX 01 03:12:22\r\n", 15000},
+		"track in name":   {"FILE \"Game (TRACK 1).bin\" BINARY\n TRACK 01 MODE2/2352\n  INDEX 01 00:00:00\n", 10},
+	}
+	for name, cue := range rejected {
+		cases["rejected "+name] = tc{cue, 10}
+	}
+	for name, c := range cases {
+		dir := t.TempDir()
+		binName, err := BinName([]byte(c.cue))
+		if err != nil {
+			binName = "a.bin"
+		}
+		bin := binData(c.sectors * SectorSize)
+		if c.sectors == 0 {
+			bin = binData(3*SectorSize + 1000)
+		}
+		os.WriteFile(filepath.Join(dir, binName), bin, 0644)
+		cuePath := filepath.Join(dir, "game.cue")
+		os.WriteFile(cuePath, []byte(c.cue), 0644)
+		cmd := exec.Command(tool, cuePath)
+		cmd.Dir = dir
+		out, _ := cmd.CombinedOutput()
+		want, cerr := os.ReadFile(filepath.Join(dir, "game.VCD"))
+		img, gerr := Load(cuePath)
+		if cerr != nil || gerr != nil {
+			if (cerr == nil) != (gerr == nil) {
+				t.Errorf("%s: cue2pops: %v, Build: %v\n%s", name, cerr, gerr, out)
+			} else {
+				t.Logf("%s: both reject", name)
+			}
+			continue
+		}
+		got := image(t, img.Layout, bin)
+		if !bytes.Equal(got, want) {
+			i := 0
+			for i < min(len(got), len(want)) && got[i] == want[i] {
+				i++
+			}
+			t.Errorf("%s: %d bytes, cue2pops %d; first difference at %#x", name, len(got), len(want), i)
+			continue
+		}
+		t.Logf("%s: identical, %d bytes", name, len(got))
+	}
+}
