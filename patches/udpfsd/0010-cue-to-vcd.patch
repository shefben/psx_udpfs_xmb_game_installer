diff --git a/internal/fs/vcd/vcd.go b/internal/fs/vcd/vcd.go
new file mode 100644
index 0000000..709acd9
--- /dev/null
+++ b/internal/fs/vcd/vcd.go
@@ -0,0 +1,628 @@
+// Package vcd serves a PS1 BIN/CUE as the POPStarter IMAGE0.VCD that
+// cue2pops v2.0 (2013/05/16) makes from it, without copying the BIN: the
+// 0x100000-byte POPS header followed by the BIN data with cue2pops' gap
+// handling, computed once and streamed on read.
+//
+// Build is a line-by-line port of cue2pops.c's main(): the same cue
+// parsing on the same mutated buffer, the same checks, header bytes,
+// +2 s index shifts (including its carry quirk: a minute ending in 9
+// gains 2: 09:58 -> 11:00), lead-out and sector count, and the same copy
+// loop with the CDRWIN fix (one PREGAP and no POSTGAP: 150 zero sectors
+// inserted at the first audio track's INDEX 00). Not ported: gap++/gap--,
+// vmode (NTSC patcher), trainer and the automatic GameFixer. Bytes that
+// cue2pops leaves uninitialised (malloc) are zeros here.
+package vcd
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+
+	"github.com/pcm720/udpfsd/internal/fs/compression/common"
+)
+
+const (
+	HeaderSize = 0x100000 // POPS header; also cue2pops' copy chunk
+	SectorSize = 2352
+	gapSectors = 150 // 2 seconds
+)
+
+// ErrRejected wraps every reason cue2pops refuses a cue sheet.
+var ErrRejected = errors.New("cue2pops rejects the cue sheet")
+
+func reject(why string) error { return fmt.Errorf("%w: %s", ErrRejected, why) }
+
+// Segment kinds after the header.
+const (
+	segZero = iota
+	segBin
+)
+
+type segment struct {
+	kind int
+	src  int64 // BIN offset (segBin)
+	n    int64
+}
+
+// Layout is a VCD: Header, then segments of BIN bytes and zeros.
+type Layout struct {
+	Header  []byte // HeaderSize bytes
+	BinName string // as written in the cue's FILE line
+	Size    int64  // whole VCD
+	segs    []segment
+	start   []int64 // VCD offset of each segment
+}
+
+// cstrstr is C strstr on buf from start: the haystack ends at the first
+// NUL. -1 if not found.
+func cstrstr(buf []byte, start int, needle string) int {
+	end := start
+	for end < len(buf) && buf[end] != 0 {
+		end++
+	}
+	if start > end {
+		return -1
+	}
+	if i := strings.Index(string(buf[start:end]), needle); i >= 0 {
+		return start + i
+	}
+	return -1
+}
+
+// at reports whether buf holds s at i (cue2pops' byte-by-byte compares).
+func at(buf []byte, i int, s string) bool {
+	return i+len(s) <= len(buf) && string(buf[i:i+len(s)]) == s
+}
+
+// ch is a cue byte as C's (signed) char.
+func ch(buf []byte, i int) int { return int(int8(buf[i])) }
+
+// bcd is cue2pops' "two decimal digits -> BCD byte": (c0-48)*16 + (c1-48).
+func bcd(buf []byte, i int) byte { return byte((ch(buf, i)-48)*16 + ch(buf, i+1) - 48) }
+
+// sectors is cue2pops' MM:SS:FF at i+9 (INDEX line at i) in sectors.
+func sectors(buf []byte, i int) int32 {
+	d := func(j int) int32 { return int32(ch(buf, j) - 48) }
+	return (d(i+9)*10+d(i+10))*4500 + (d(i+12)*10+d(i+13))*75 + (d(i+15)*10 + d(i+16))
+}
+
+var (
+	plus8 = []byte{0x08, 0x09, 0x18, 0x19, 0x28, 0x29, 0x38, 0x39, 0x48, 0x49}
+	nines = []byte{0x09, 0x19, 0x29, 0x39, 0x49, 0x59, 0x69, 0x79, 0x89}
+)
+
+func in(set []byte, v byte) bool {
+	for _, x := range set {
+		if v == x {
+			return true
+		}
+	}
+	return false
+}
+
+// plus2 is cue2pops' "+ 2 SEC" on the BCD minute/second bytes h[m], h[s]
+// (the branch taken for tracks after the first).
+func plus2(h []byte, m, s int) {
+	switch {
+	case in(plus8, h[s]):
+		h[s] += 8 // 0x08 -> 0x10
+	case h[s] == 0x58 || h[s] == 0x59:
+		if h[s] == 0x58 {
+			h[s] = 0x00
+		}
+		if h[s] == 0x59 {
+			h[s] = 0x01
+		}
+		for _, x := range nines { // 0x09 -> 0x10, ... 0x89 -> 0x90
+			if h[m] == x {
+				h[m] = x + 7
+			}
+		}
+		if !in(nines, h[m]) { // always true by now: 0x09 ends up 0x11
+			h[m]++
+		}
+	default:
+		h[s] += 2
+	}
+}
+
+// BinName returns the BIN file name a cue sheet names, as cue2pops reads
+// it (the quoted name after the first "FILE "), or an error if cue2pops
+// rejects the sheet before that.
+func BinName(cue []byte) (string, error) {
+	buf, _, err := fileName(cue)
+	return buf, err
+}
+
+func fileName(cue []byte) (string, []byte, error) {
+	n := len(cue)
+	if n == 0 {
+		return "", nil, reject("empty cue sheet")
+	}
+	// cue_buf = malloc(cue_size * 2); here the rest is zeros, plus room for
+	// cue2pops' fixed-width look-ahead past the end.
+	buf := make([]byte, 2*n+64)
+	copy(buf, cue)
+
+	p := cstrstr(buf, 0, "INDEX 01 ")
+	if p < 0 {
+		return "", nil, reject("no INDEX 01") // cue2pops crashes
+	}
+	if p += 9; buf[p] != '0' || buf[p+1] != '0' {
+		return "", nil, reject("the first INDEX 01 is not at 00:xx:xx")
+	}
+	p = cstrstr(buf, 0, "FILE ")
+	if p < 0 {
+		return "", nil, reject("no FILE line") // cue2pops crashes
+	}
+	if p += 5; buf[p] != '"' {
+		return "", nil, reject("FILE name is not quoted")
+	}
+	for i := 0; i < n; i++ {
+		if buf[i] == '"' {
+			buf[i] = 0
+		}
+	}
+	p++
+	end := p
+	for buf[end] != 0 {
+		end++
+	}
+	return string(buf[p:end]), buf, nil
+}
+
+// Build computes the VCD cue2pops makes from a cue sheet. binSize returns
+// the size of the BIN the cue names (called once, after the cue checks,
+// where cue2pops opens it).
+func Build(cue []byte, binSize func(name string) (int64, error)) (*Layout, error) {
+	name, buf, err := fileName(cue)
+	if err != nil {
+		return nil, err
+	}
+	n := len(cue)
+	h := make([]byte, HeaderSize)
+	h[0] = 0x41  // 1st track type: data
+	h[2] = 0xA0  // A0: disc type
+	h[7] = 0x01  // first track number
+	h[8] = 0x20  // CD-XA001
+	h[12] = 0xA1 // A1: content
+	h[22] = 0xA2 // A2: lead-in/lead-out
+
+	i := 0
+	for ; i < n; i++ {
+		if at(buf, i, "TRACK 01") {
+			break
+		}
+	}
+	if cstrstr(buf, i, "TRACK 01 MODE2/2352") < 0 {
+		return nil, reject("not MODE2/2352")
+	}
+
+	var tracks, index1, binary, wave, pregaps, postgaps int
+	for i := 0; i < n; i++ {
+		if c := buf[i]; c == ':' || c == 0x0D || c == 0x0A {
+			buf[i] = 0
+		}
+		switch {
+		case at(buf, i, "TRACK "):
+			tracks++
+		case at(buf, i, "INDEX 01"):
+			index1++
+		case at(buf, i, "BINARY"):
+			binary++
+		case at(buf, i, "WAVE"):
+			wave++
+		case at(buf, i, "PREGAP"):
+			pregaps++
+		case at(buf, i, "POSTGAP"):
+			postgaps++
+		}
+	}
+	if binary == 0 {
+		return nil, reject("no BINARY file")
+	}
+	if tracks == 0 || tracks != index1 {
+		return nil, reject("TRACK and INDEX 01 counts differ")
+	}
+	if binary != 1 || wave != 0 {
+		return nil, reject("more than one file, or WAVE audio")
+	}
+	if 20+10*tracks+10 > 1024 {
+		return nil, reject("too many tracks") // their entries would run into 0x400
+	}
+	cdrwin := pregaps == 1 && postgaps == 0
+
+	hp := 20
+	gap := 0
+	var daTrack int32 // BIN offset of the first audio track (INDEX 00, else 01)
+	noCDDA := false
+	for t := 0; t < tracks; t++ {
+		hp += 10
+		for q := 0; q < n; q++ {
+			if !at(buf, q, "TRACK ") {
+				continue
+			}
+			clear(buf[q : q+6])
+			typ := byte(0x41) // data
+			if buf[q+13] == 'O' {
+				typ = 0x01 // AUDIO
+			}
+			h[10], h[20], h[hp] = typ, typ, typ
+			h[hp+2] = bcd(buf, q+6) // track number
+			h[17] = h[hp+2]         // last track number
+			break
+		}
+		for q := 0; q < n; q++ {
+			if at(buf, q, "INDEX 00") {
+				gap = q
+				clear(buf[q : q+8])
+			}
+			if !at(buf, q, "INDEX 01") {
+				continue
+			}
+			clear(buf[q : q+8])
+			m, s, f := bcd(buf, q+9), bcd(buf, q+12), bcd(buf, q+15)
+			switch {
+			case daTrack == 0 && h[10] == 0x01 && gap != 0:
+				daTrack = sectors(buf, gap) * SectorSize
+			case daTrack == 0 && h[10] == 0x01 && gap == 0:
+				daTrack = sectors(buf, q) * SectorSize
+			case daTrack == 0 && h[10] == 0x41 && t == tracks-1:
+				noCDDA = true
+			}
+			h[hp+3], h[hp+4], h[hp+5] = m, s, f // INDEX 00 (= INDEX 01 if none)
+			h[hp+7], h[hp+8], h[hp+9] = m, s, f // INDEX 01
+			if gap != 0 {
+				h[hp+3], h[hp+4], h[hp+5] = bcd(buf, gap+9), bcd(buf, gap+12), bcd(buf, gap+15)
+			}
+			// Unconditional +2 s: INDEX 00 after track 1, INDEX 01 always.
+			if t != 0 {
+				plus2(h, hp+3, hp+4)
+				plus2(h, hp+7, hp+8)
+			} else {
+				h[hp+8] += 2
+			}
+			if cdrwin && t != 0 { // the CDRWIN fix: +2 s more
+				plus2(h, hp+3, hp+4)
+				plus2(h, hp+7, hp+8)
+			}
+			gap = 0
+			break
+		}
+	}
+
+	size, err := binSize(name)
+	if err != nil {
+		return nil, err
+	}
+	// cue2pops keeps the size in an int and steps through it in 1 MiB.
+	if size < 0 || size > math.MaxInt32-HeaderSize {
+		return nil, reject("BIN larger than 2 GiB")
+	}
+	bs := int32(size)
+
+	// Lead-out MSF from the BIN size, via sprintf("%02d") into char[7].
+	sc := bs/SectorSize + gapSectors*int32(pregaps+postgaps) + gapSectors
+	lm := sc / 4500
+	ls := (sc - lm*4500) / 75
+	lf := sc - lm*4500 - ls*75
+	var lo [16]byte
+	for k, v := range []int32{lm, ls, lf} {
+		d := fmt.Sprintf("%02d", v)
+		copy(lo[2*k:], d)
+		lo[2*k+len(d)] = 0
+	}
+	for k := 0; k < 3; k++ {
+		h[27+k] = byte((int(int8(lo[2*k]))-'0')*16 + int(int8(lo[2*k+1])) - '0')
+	}
+	count := bs/SectorSize + gapSectors*int32(pregaps+postgaps)
+	if noCDDA {
+		daTrack = bs
+	}
+	for _, o := range []int{1032, 1036} { // sector count, little-endian
+		h[o], h[o+1], h[o+2], h[o+3] = byte(count), byte(count>>8), byte(count>>16), byte(count>>24)
+	}
+	h[1024], h[1025], h[1026], h[1027] = 'k', 'H', 'n', 0x20 // cue2pops v2.0 ident
+
+	l := &Layout{Header: h, BinName: name}
+	if err := l.copyLoop(bs, daTrack, cdrwin); err != nil {
+		return nil, err
+	}
+	l.Size = HeaderSize
+	for _, sg := range l.segs {
+		l.start = append(l.start, l.Size)
+		l.Size += sg.n
+	}
+	return l, nil
+}
+
+// run is a stretch of cue2pops' 1 MiB output buffer and what it holds.
+type run struct {
+	from, to int64 // buffer offsets
+	kind     int
+	src      int64 // BIN offset of buffer offset `from` (segBin)
+}
+
+// copyLoop replays cue2pops' fread/fwrite loop: which BIN bytes, zeros, and
+// stale buffer bytes (a short fread at the end of the BIN leaves the rest of
+// the buffer as it was) end up in the VCD after the header.
+func (l *Layout) copyLoop(bs, daTrack int32, cdrwin bool) error {
+	const chunk = HeaderSize
+	outbuf := []run{{0, chunk, segZero, 0}} // malloc'd: zeros here
+	var pos int64                           // BIN file position
+	fread := func(k int64) {
+		got := min(k, max(0, int64(bs)-pos))
+		if got == 0 {
+			return
+		}
+		next := []run{{0, got, segBin, pos}}
+		for _, r := range outbuf {
+			if r.to <= got {
+				continue
+			}
+			if r.from < got {
+				if r.kind == segBin {
+					r.src += got - r.from
+				}
+				r.from = got
+			}
+			next = append(next, r)
+		}
+		outbuf, pos = next, pos+got
+	}
+	fwrite := func(k int64) {
+		for _, r := range outbuf {
+			if r.from >= k {
+				break
+			}
+			l.add(segment{r.kind, r.src, min(r.to, k) - r.from})
+		}
+	}
+	for i := int32(0); i < bs; i += chunk {
+		if cdrwin && i+chunk >= daTrack {
+			first := int64(daTrack - i)
+			if first < 0 {
+				return reject("audio track before the BIN start")
+			}
+			fread(first)
+			fwrite(first)
+			l.add(segment{segZero, 0, gapSectors * SectorSize}) // the inserted pregap
+			fread(chunk - first)
+			fwrite(chunk - first)
+			cdrwin = false
+		} else {
+			fread(chunk)
+			if i+chunk >= bs {
+				fwrite(int64(bs - i))
+			} else {
+				fwrite(chunk)
+			}
+		}
+	}
+	return nil
+}
+
+func (l *Layout) add(s segment) {
+	if s.n <= 0 {
+		return
+	}
+	if k := len(l.segs) - 1; k >= 0 {
+		p := &l.segs[k]
+		if p.kind == s.kind && (s.kind == segZero || p.src+p.n == s.src) {
+			p.n += s.n
+			return
+		}
+	}
+	l.segs = append(l.segs, s)
+}
+
+// ReadAt fills p with the VCD bytes at off; bin reads the BIN.
+func (l *Layout) ReadAt(p []byte, off int64, bin io.ReaderAt) (int, error) {
+	if off < 0 {
+		return 0, errors.New("negative offset")
+	}
+	done := 0
+	for done < len(p) && off < l.Size {
+		q := p[done:]
+		var n int
+		if off < HeaderSize {
+			n = copy(q, l.Header[off:])
+		} else {
+			k := len(l.start) - 1
+			for k > 0 && l.start[k] > off {
+				k--
+			}
+			sg, in := l.segs[k], off-l.start[k]
+			q = q[:min(int64(len(q)), sg.n-in)]
+			if sg.kind == segZero {
+				n = len(q)
+				clear(q)
+			} else {
+				var err error
+				if n, err = bin.ReadAt(q, sg.src+in); n < len(q) {
+					if err == nil || err == io.EOF {
+						err = io.ErrUnexpectedEOF // the BIN shrank
+					}
+					return done + n, err
+				}
+			}
+		}
+		done += n
+		off += int64(n)
+	}
+	if done < len(p) {
+		return done, io.EOF
+	}
+	return done, nil
+}
+
+// FindBin resolves a cue's BIN name in the cue's folder: the name as a
+// path below that folder, else its last component; letter case is matched
+// loosely. cue2pops also accepts paths elsewhere; the server never reads
+// outside the served folder.
+func FindBin(cueDir, name string) (string, error) {
+	rel := filepath.FromSlash(strings.ReplaceAll(name, "\\", "/"))
+	var tries []string
+	if filepath.IsLocal(rel) {
+		tries = append(tries, filepath.Join(cueDir, rel))
+	}
+	tries = append(tries, filepath.Join(cueDir, filepath.Base(rel)))
+	for _, p := range tries {
+		if st, err := os.Stat(p); err == nil && st.Mode().IsRegular() {
+			return p, nil
+		}
+	}
+	base := filepath.Base(rel)
+	if ents, err := os.ReadDir(cueDir); err == nil {
+		for _, e := range ents {
+			if strings.EqualFold(e.Name(), base) && e.Type().IsRegular() {
+				return filepath.Join(cueDir, e.Name()), nil
+			}
+		}
+	}
+	return "", fmt.Errorf("%w: BIN %q not found next to the cue", ErrRejected, name)
+}
+
+// Image is a cue's VCD: its layout and the files it comes from.
+type Image struct {
+	*Layout
+	CuePath, BinPath string
+	ModTime          time.Time // newest of cue and BIN
+}
+
+// maxCue: cue sheets are small; anything bigger is not one.
+const maxCue = 1 << 20
+
+// Load builds the VCD of the cue at cuePath.
+func Load(cuePath string) (*Image, error) {
+	cst, err := os.Stat(cuePath)
+	if err != nil {
+		return nil, err
+	}
+	if cst.Size() > maxCue {
+		return nil, reject("cue sheet larger than 1 MiB")
+	}
+	cue, err := os.ReadFile(cuePath)
+	if err != nil {
+		return nil, err
+	}
+	img := &Image{CuePath: cuePath, ModTime: cst.ModTime()}
+	img.Layout, err = Build(cue, func(name string) (int64, error) {
+		p, err := FindBin(filepath.Dir(cuePath), name)
+		if err != nil {
+			return 0, err
+		}
+		st, err := os.Stat(p)
+		if err != nil {
+			return 0, err
+		}
+		img.BinPath = p
+		if st.ModTime().After(img.ModTime) {
+			img.ModTime = st.ModTime()
+		}
+		return st.Size(), nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return img, nil
+}
+
+// Info is the VCD's stat under the given name.
+func (img *Image) Info(name string) os.FileInfo {
+	return common.NewCompressedInfo(name, img.Size, img.ModTime)
+}
+
+// FindCue returns the cue sheet that the (virtual) VCD at vcdPath stands
+// for: Name.cue next to it, letter case matched loosely.
+func FindCue(vcdPath string) (string, bool) {
+	if !strings.EqualFold(filepath.Ext(vcdPath), ".vcd") {
+		return "", false
+	}
+	stem := strings.TrimSuffix(vcdPath, filepath.Ext(vcdPath))
+	for _, ext := range []string{".cue", ".CUE"} {
+		if st, err := os.Stat(stem + ext); err == nil && st.Mode().IsRegular() {
+			return stem + ext, true
+		}
+	}
+	want := filepath.Base(stem) + ".cue"
+	ents, err := os.ReadDir(filepath.Dir(vcdPath))
+	if err != nil {
+		return "", false
+	}
+	for _, e := range ents {
+		if strings.EqualFold(e.Name(), want) && e.Type().IsRegular() {
+			return filepath.Join(filepath.Dir(vcdPath), e.Name()), true
+		}
+	}
+	return "", false
+}
+
+// VCDName is the name a cue sheet is listed as: "Game.cue" -> "Game.VCD".
+func VCDName(cueName string) string {
+	return strings.TrimSuffix(cueName, filepath.Ext(cueName)) + ".VCD"
+}
+
+// File reads a VCD (interfaces.FileObject, read-only).
+type File struct {
+	img  *Image
+	name string // host path of the VCD, as for a real file
+	info os.FileInfo
+	bin  *os.File
+	pos  int64
+}
+
+// Open opens the VCD of the cue at cuePath; vcdPath is the name it is
+// served under.
+func Open(cuePath, vcdPath string) (*File, error) {
+	img, err := Load(cuePath)
+	if err != nil {
+		return nil, err
+	}
+	bin, err := os.Open(img.BinPath)
+	if err != nil {
+		return nil, err
+	}
+	return &File{img: img, name: vcdPath, info: img.Info(filepath.Base(vcdPath)), bin: bin}, nil
+}
+
+func (f *File) Read(p []byte) (int, error) {
+	if f.pos >= f.img.Size {
+		return 0, io.EOF
+	}
+	n, err := f.img.ReadAt(p, f.pos, f.bin)
+	f.pos += int64(n)
+	if err == io.EOF && n > 0 {
+		err = nil
+	}
+	return n, err
+}
+
+func (f *File) Seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		offset += f.pos
+	case io.SeekEnd:
+		offset += f.img.Size
+	default:
+		return f.pos, fmt.Errorf("invalid whence %d", whence)
+	}
+	if offset < 0 {
+		return f.pos, errors.New("negative position")
+	}
+	f.pos = offset
+	return f.pos, nil
+}
+
+// Write: VCDs made from cue sheets are read-only.
+func (f *File) Write([]byte) (int, error) { return 0, os.ErrPermission }
+
+func (f *File) Stat() (os.FileInfo, error) { return f.info, nil }
+func (f *File) Name() string               { return f.name }
+func (f *File) Close() error               { return f.bin.Close() }
