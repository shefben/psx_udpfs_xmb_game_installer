+	"index at 01 min": "FILE \"a.bin\" BINARY\nTRACK 01 MODE2/2352\nINDEX 01 01:00:00\n",
+	"unquoted file":   "FILE a.bin BINARY\nTRACK 01 MODE2/2352\nINDEX 01 00:00:00\n",
