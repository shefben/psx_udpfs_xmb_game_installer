+	b.Close(h)
+	wantList := map[string]uint32{"Game (USA).VCD": uint32(len(want)), "Game (USA).bin": uint32(len(bin)),
+		"Real.cue": uint32(len(cue)), "Real.VCD": 10, "Bad.cue": uint32(len(badCue)), "Bad.bin": 1, "POPSTARTER.KELF": 4}
+	if len(sizes) != len(wantList) {
+		t.Fatalf("listing %v", sizes)
+	}
+	for n, s := range wantList {
+		if sizes[n] != s {
+			t.Fatalf("listing %v, want %v", sizes, wantList)
+		}
+	}
+	if got := listDir(t, b, "/APPS"); !eq(got, []string{"Game (USA).bin", "Game (USA).cue"}) {
+		t.Fatalf("VCD outside POPS/CD: %v", got)
+	}
+
+	if gs, err := b.Getstat("/POPS/Game (USA).VCD"); err != nil || int(gs.Size) != len(want) {
+		t.Fatalf("getstat %d %v", gs.Size, err)
+	}
+	h, st, err := b.Open("/POPS/Game (USA).VCD", os.O_RDONLY, false)
+	if err != nil || int(st.Size) != len(want) {
+		t.Fatalf("open %d %v", st.Size, err)
+	}
+	buf := make([]byte, 128*1024)
+	b.Lseek(h, vcd.HeaderSize-100, io.SeekStart)
+	if n, got, err := b.Read(h, 1000, buf); err != nil || n != 1000 || !bytes.Equal(got, want[vcd.HeaderSize-100:vcd.HeaderSize+900]) {
+		t.Fatalf("read across the header: %d %v", n, err)
+	}
+	if pos, _ := b.Lseek(h, 0, io.SeekEnd); pos != int64(len(want)) {
+		t.Fatalf("SEEK_END %d", pos)
+	}
+	b.Close(h)
+	if got, err := readAll(t, b, "/POPS/Real.VCD"); err != nil || got != "a real VCD" {
+		t.Fatalf("real VCD: %q %v", got, err)
+	}
+	if _, err := readAll(t, b, "/POPS/Bad.VCD"); err == nil {
+		t.Fatal("rejected cue served")
+	}
+	if _, err := readAll(t, b, "/APPS/Game (USA).VCD"); err == nil {
+		t.Fatal("VCD served outside POPS/CD")
+	}
+	if _, _, err := b.Open("/POPS/Game (USA).VCD", os.O_RDWR, false); err == nil {
+		t.Fatal("VCD opened for writing")
+	}
+	h, _, err = b.Open("/.lz4f/POPS/Game (USA).VCD", os.O_RDONLY, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := readFrames(t, b, h, 131072); !bytes.Equal(got, want) {
+		t.Fatal("framed VCD differs")
+	}
+	b.Close(h)
+}
