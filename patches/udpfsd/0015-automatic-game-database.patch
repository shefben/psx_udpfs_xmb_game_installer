+package prep
+
+import (
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"os"
+	"path/filepath"
+	"time"
+)
+
+// GDX's public OPL database; pin a reviewed revision for reproducible metadata.
+const GameDBBaseURL = "https://raw.githubusercontent.com/GDX-X/OPL-Games-Infos-Database-Project/0ee1ed2913c83006401e823943777068b3a1ebd8"
+
+func automaticGameDB(cache string, client *http.Client, base string) map[string]GameInfo {
+	if client == nil {
+		client = &http.Client{Timeout: 20 * time.Second}
+	}
+	out := map[string]GameInfo{}
+	dir := filepath.Join(cache, "gamedb")
+	if err := os.MkdirAll(dir, 0755); err != nil {
+		log.Printf("prep: game database cache: %v", err)
+		return out
+	}
+	for _, name := range []string{"PS2DB_EN.xml", "PS1DB_EN.xml"} {
+		dst := filepath.Join(dir, name)
+		db, err := LoadGameDB(dst)
+		if err == nil && len(db) > 0 {
+			for id, g := range db {
+				out[id] = g
+			}
+			continue
+		}
+		if err := fetchGameDB(client, base+"/"+name, dst); err != nil {
+			log.Printf("prep: automatic %s unavailable: %v (game installation remains available)", name, err)
+			continue
+		}
+		db, err = LoadGameDB(dst)
+		if err == nil {
+			for id, g := range db {
+				out[id] = g
+			}
+		}
+	}
+	log.Printf("prep: automatic game database: %d IDs ready", len(out))
+	return out
+}
+
+func fetchGameDB(client *http.Client, url, dst string) error {
+	res, err := client.Get(url)
+	if err != nil {
+		return err
+	}
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return fmt.Errorf("HTTP %d", res.StatusCode)
+	}
+	data, err := io.ReadAll(io.LimitReader(res.Body, (32<<20)+1))
+	if err != nil || len(data) == 0 || len(data) > 32<<20 {
+		return fmt.Errorf("empty, oversized or unreadable database")
+	}
+	tmp := dst + ".tmp"
+	if err := os.WriteFile(tmp, data, 0644); err != nil {
+		return err
+	}
+	defer os.Remove(tmp)
+	db, err := LoadGameDB(tmp)
+	if err != nil || len(db) == 0 {
+		return fmt.Errorf("invalid game database: %v", err)
+	}
+	return os.Rename(tmp, dst)
+}
