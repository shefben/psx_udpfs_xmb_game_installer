+package prep
+
+import (
+ "net/http"
+ "net/http/httptest"
+ "os"
+ "path/filepath"
+ "strings"
+ "testing"
+)
+
+func TestAutomaticGameDBDownloadsAndUsesCache(t *testing.T) {
+ calls:=0
+ server:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){
+  calls++
+  id:="SLUS-20312"
+  if strings.Contains(r.URL.Path,"PS1") { id="SLUS-00594" }
+  w.Write([]byte(`<datafile><game serial="`+id+`"><Developer>Test`+string([]byte{0xa0})+`Studio</Developer><Description>Matching story</Description></game></datafile>`))
+ }))
+ defer server.Close()
+ cache:=t.TempDir()
+ db:=automaticGameDB(cache,server.Client(),server.URL)
+ if len(db)!=2 || db["SLUS_203.12"].Description!="Matching story" || db["SLUS_005.94"].Description!="Matching story" || calls!=2 { t.Fatalf("%+v calls=%d",db,calls) }
+ if db["SLUS_203.12"].Developer!="Test Studio" { t.Fatal("invalid UTF8 prevented metadata import") }
+ server.Close()
+ if len(automaticGameDB(cache,server.Client(),server.URL))!=2 { t.Fatal("offline cache not reused") }
+}
+
+func TestAutomaticGameDBRejectsBadDownload(t *testing.T) {
+ server:=httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request){ w.Write([]byte("<html>Not a database</html>")) }))
+ defer server.Close()
+ cache:=t.TempDir()
+ if len(automaticGameDB(cache,server.Client(),server.URL))!=0 { t.Fatal("invalid database accepted") }
+ if _,err:=os.Stat(filepath.Join(cache,"gamedb","PS2DB_EN.xml"));err==nil { t.Fatal("bad download cached permanently") }
+}
