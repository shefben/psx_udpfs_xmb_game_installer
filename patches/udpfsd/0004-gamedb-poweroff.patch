diff --git a/internal/prep/gamedb.go b/internal/prep/gamedb.go
new file mode 100644
index 0000000..64e305a
--- /dev/null
+++ b/internal/prep/gamedb.go
@@ -0,0 +1,148 @@
+package prep
+
+import (
+	"encoding/xml"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// GameInfo is the XMB info of one game (OPL-Games-Infos-Database, the
+// PS2DB.xml / PS1DB.xml shipped with PFS-BatchKit-Manager).
+type GameInfo struct {
+	Release, Developer, Publisher, Genre string
+}
+
+type dbGame struct {
+	Serial    string `xml:"serial,attr"`
+	Release   string `xml:"Release"`
+	Developer string `xml:"Developer"`
+	Publisher string `xml:"Publisher"`
+	Genre     string `xml:"Genre"`
+}
+
+// LoadGameDB reads a game database keyed by game ID ("SLUS_203.12").
+func LoadGameDB(path string) (map[string]GameInfo, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return nil, err
+	}
+	defer f.Close()
+	out := map[string]GameInfo{}
+	d := xml.NewDecoder(f)
+	// The real database has bare "&" in names ("Tom & Jerry"): be lenient.
+	d.Strict = false
+	d.AutoClose = xml.HTMLAutoClose
+	d.Entity = xml.HTMLEntity
+	for {
+		tok, err := d.Token()
+		if err != nil {
+			if err.Error() == "EOF" {
+				return out, nil
+			}
+			return out, fmt.Errorf("gamedb %s: %w", path, err)
+		}
+		se, ok := tok.(xml.StartElement)
+		if !ok || se.Name.Local != "game" {
+			continue
+		}
+		var g dbGame
+		if err := d.DecodeElement(&g, &se); err != nil {
+			return out, fmt.Errorf("gamedb %s: %w", path, err)
+		}
+		id := serialToID(g.Serial)
+		if id == "" {
+			continue
+		}
+		out[id] = GameInfo{Release: ReleaseDate(g.Release),
+			Developer: strings.TrimRight(Sanitize(g.Developer, 63), ", "),
+			Publisher: strings.TrimRight(Sanitize(g.Publisher, 63), ", "),
+			Genre:     Sanitize(g.Genre, 31)}
+	}
+}
+
+// "SLUS-20312" -> "SLUS_203.12"; "" if it is not a game ID.
+func serialToID(s string) string {
+	s = strings.TrimSpace(s)
+	if len(s) != 10 || s[4] != '-' {
+		return ""
+	}
+	id := s[:4] + "_" + s[5:8] + "." + s[8:10]
+	if !ValidID(id) {
+		return ""
+	}
+	return id
+}
+
+var months = map[string]int{
+	"january": 1, "february": 2, "march": 3, "april": 4, "may": 5, "june": 6, "july": 7,
+	"august": 8, "september": 9, "october": 10, "november": 11, "december": 12,
+	"janvier": 1, "février": 2, "fevrier": 2, "mars": 3, "avril": 4, "mai": 5, "juin": 6,
+	"juillet": 7, "août": 8, "aout": 8, "septembre": 9, "octobre": 10, "novembre": 11,
+	"décembre": 12, "decembre": 12,
+}
+
+var (
+	dayMonthYear = regexp.MustCompile(`^(\d{1,2})(?:er)?\s+(\pL+)\s+(\d{4})$`)
+	monthDayYear = regexp.MustCompile(`^(\pL+)\s+(\d{1,2}),?\s+(\d{4})$`)
+	isoDate      = regexp.MustCompile(`^(\d{4})-(\d{2})-(\d{2})$`)
+)
+
+// ReleaseDate converts "17 Décembre 2001", "December 17, 2001" or
+// "2001-12-17" to the XMB's YYYYMMDD (as PFS-BatchKit-Manager writes
+// it); "" if the date is unknown or partial.
+func ReleaseDate(s string) string {
+	s = strings.TrimSpace(s)
+	var d, m, y int
+	if g := dayMonthYear.FindStringSubmatch(s); g != nil {
+		d, _ = strconv.Atoi(g[1])
+		m = months[strings.ToLower(g[2])]
+		y, _ = strconv.Atoi(g[3])
+	} else if g := monthDayYear.FindStringSubmatch(s); g != nil {
+		m = months[strings.ToLower(g[1])]
+		d, _ = strconv.Atoi(g[2])
+		y, _ = strconv.Atoi(g[3])
+	} else if g := isoDate.FindStringSubmatch(s); g != nil {
+		y, _ = strconv.Atoi(g[1])
+		m, _ = strconv.Atoi(g[2])
+		d, _ = strconv.Atoi(g[3])
+	}
+	if m < 1 || m > 12 || d < 1 || d > 31 || y < 1990 || y > 2099 {
+		return ""
+	}
+	return fmt.Sprintf("%04d%02d%02d", y, m, d)
+}
+
+// infoText is served as /.udpfsd/info/<ID>.txt; empty fields are left out.
+func infoText(g GameInfo) string {
+	var b strings.Builder
+	for _, kv := range [][2]string{{"release_date", g.Release}, {"developer", g.Developer},
+		{"publisher", g.Publisher}, {"genre", g.Genre}} {
+		if kv[1] != "" {
+			fmt.Fprintf(&b, "%s=%s\n", kv[0], kv[1])
+		}
+	}
+	return b.String()
+}
+
+// writeInfo writes info/<ID>.txt for a game found in the database and
+// removes a stale one otherwise.
+func writeInfo(served, id string, db map[string]GameInfo) {
+	p := filepath.Join(served, "info", id+".txt")
+	g, ok := db[id]
+	text := ""
+	if ok {
+		text = infoText(g)
+	}
+	if text == "" {
+		os.Remove(p)
+		return
+	}
+	if old, err := os.ReadFile(p); err == nil && string(old) == text {
+		return
+	}
+	writeAtomic(p, []byte(text))
+}
diff --git a/internal/prep/gamedb_test.go b/internal/prep/gamedb_test.go
new file mode 100644
index 0000000..8042b69
--- /dev/null
+++ b/internal/prep/gamedb_test.go
@@ -0,0 +1,81 @@
+package prep
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+const sampleDB = `<?xml version="1.0" encoding="utf-8"?>
+<datafile>
+	<PS2GamesDB version="1" filter="FR" />
+	<game serial="SLUS-20312">
+		<Title>Final Fantasy X</Title>
+		<Serial>SLUS-20312</Serial>
+		<Release>17 Décembre 2001</Release>
+		<Developer>Square Co. Ltd</Developer>
+		<Notes>Tom & Jerry</Notes>
+		<Publisher>Square Enix</Publisher>
+		<Genre>RPG</Genre>
+		<Description>long text</Description>
+	</game>
+	<game serial="SLES-52392">
+		<Release></Release>
+		<Developer>BattleBorne & Co,</Developer>
+		<Genre>Action</Genre>
+	</game>
+	<game serial="BOGUS">
+		<Genre>x</Genre>
+	</game>
+</datafile>
+`
+
+func TestLoadGameDB(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "PS2DB.xml")
+	os.WriteFile(p, []byte(sampleDB), 0o644)
+	db, err := LoadGameDB(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(db) != 2 {
+		t.Fatalf("%d entries", len(db))
+	}
+	g := db["SLUS_203.12"]
+	if g != (GameInfo{"20011217", "Square Co. Ltd", "Square Enix", "RPG"}) {
+		t.Fatalf("%+v", g)
+	}
+	if g := db["SLES_523.92"]; g.Developer != "BattleBorne & Co" || g.Release != "" {
+		t.Fatalf("%+v", g)
+	}
+}
+
+func TestReleaseDate(t *testing.T) {
+	for in, want := range map[string]string{
+		"17 Décembre 2001":  "20011217",
+		"1er Juillet 2003":  "20030701",
+		"December 17, 2001": "20011217",
+		"5 March 2004":      "20040305",
+		"2004-03-05":        "20040305",
+		"2004":              "",
+		"":                  "",
+		"31 Smarch 2004":    "",
+	} {
+		if got := ReleaseDate(in); got != want {
+			t.Errorf("%q: %q, want %q", in, got, want)
+		}
+	}
+}
+
+func TestWriteInfo(t *testing.T) {
+	served := t.TempDir()
+	db := map[string]GameInfo{"SLUS_203.12": {"20011217", "Square", "", "RPG"}}
+	writeInfo(served, "SLUS_203.12", db)
+	b, err := os.ReadFile(filepath.Join(served, "info", "SLUS_203.12.txt"))
+	if err != nil || string(b) != "release_date=20011217\ndeveloper=Square\ngenre=RPG\n" {
+		t.Fatalf("%v %q", err, b)
+	}
+	writeInfo(served, "SLUS_203.12", map[string]GameInfo{}) // no longer in the DB
+	if _, err := os.Stat(filepath.Join(served, "info", "SLUS_203.12.txt")); err == nil {
+		t.Fatal("stale info kept")
+	}
+}
