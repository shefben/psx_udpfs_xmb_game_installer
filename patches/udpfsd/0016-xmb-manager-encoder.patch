+package prep
+
+import (
+	"os"
+	"path/filepath"
+	"runtime"
+	"testing"
+)
+
+func requireWindowsEncoder(t *testing.T) {
+	t.Helper()
+	if runtime.GOOS != "windows" {
+		if _, err := os.Stat("/proc/sys/fs/binfmt_misc/WSLInterop"); err != nil {
+			t.Skip("dynamic artwork requires Windows .NET or WSL; native Linux uses prepared/default jackets")
+		}
+	}
+}
+
+func TestXMBManagerCacheProvenance(t *testing.T) {
+	requireWindowsEncoder(t)
+	dir := t.TempDir()
+	src, dst := filepath.Join(dir, "source.png"), filepath.Join(dir, "jkt.png")
+	writeImg(t, src, 512, 736, false)
+	if err := MakeJacket(src, dst); err != nil {
+		t.Fatal(err)
+	}
+	if !bothJackets(dst) {
+		t.Fatal("canonical pair not accepted")
+	}
+	// A dimensions-only old cover must not survive the pipeline change.
+	if err := os.Remove(dst + ".xmb-manager"); err != nil {
+		t.Fatal(err)
+	}
+	if bothJackets(dst) {
+		t.Fatal("unmarked legacy art was accepted")
+	}
+	if err := MakeJacket(src, dst); err != nil {
+		t.Fatal(err)
+	}
+	data, _ := os.ReadFile(dst)
+	data[len(data)-1] ^= 1
+	os.WriteFile(dst, data, 0600)
+	if bothJackets(dst) {
+		t.Fatal("modified cover was accepted")
+	}
+}
