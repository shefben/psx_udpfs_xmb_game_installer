diff --git a/internal/fs/split/split.go b/internal/fs/split/split.go
new file mode 100644
index 0000000..ffc81c4
--- /dev/null
+++ b/internal/fs/split/split.go
@@ -0,0 +1,174 @@
+// Package split serves a split disc image, "Name.iso.001", "Name.iso.002",
+// ... (consecutive, from .001), as one read-only "Name.iso".
+package split
+
+import (
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strconv"
+	"time"
+
+	"github.com/pcm720/udpfsd/internal/fs/compression/common"
+)
+
+var partRe = regexp.MustCompile(`^(.+\.(?i:iso))\.([0-9]{3})$`)
+
+// PartOf reports whether name is a part "<image>.NNN" of a split image
+// ("Game.iso.001" -> "Game.iso", 1).
+func PartOf(name string) (image string, n int, ok bool) {
+	m := partRe.FindStringSubmatch(name)
+	if m == nil {
+		return "", 0, false
+	}
+	n, _ = strconv.Atoi(m[2])
+	return m[1], n, n > 0
+}
+
+// PartName is the name of part n of image.
+func PartName(image string, n int) string { return fmt.Sprintf("%s.%03d", image, n) }
+
+// Part is one piece of a split image.
+type Part struct {
+	Path    string
+	Size    int64
+	ModTime time.Time
+}
+
+// Parts returns the parts of the split image at path (".../Name.iso"):
+// path.001, path.002, ... up to the first missing number. nil if there is
+// no path.001.
+func Parts(path string) []Part {
+	var parts []Part
+	for n := 1; n <= 999; n++ {
+		p := PartName(path, n)
+		st, err := os.Stat(p)
+		if err != nil || !st.Mode().IsRegular() {
+			break
+		}
+		parts = append(parts, Part{Path: p, Size: st.Size(), ModTime: st.ModTime()})
+	}
+	return parts
+}
+
+// Info is the stat of the image made of parts: summed size, newest time.
+func Info(name string, parts []Part) os.FileInfo {
+	var size int64
+	var mt time.Time
+	for _, p := range parts {
+		size += p.Size
+		if p.ModTime.After(mt) {
+			mt = p.ModTime
+		}
+	}
+	return common.NewCompressedInfo(name, size, mt)
+}
+
+// Stat returns the stat of the split image at path, or nil if there is none.
+func Stat(path string) os.FileInfo {
+	parts := Parts(path)
+	if parts == nil {
+		return nil
+	}
+	return Info(filepath.Base(path), parts)
+}
+
+// File reads the parts as one image (interfaces.FileObject).
+type File struct {
+	path  string
+	parts []Part
+	start []int64 // image offset of each part
+	info  os.FileInfo
+	size  int64
+	pos   int64
+	cur   int // index of the open part, -1 if none
+	f     *os.File
+}
+
+// Open opens the split image at path (".../Name.iso").
+func Open(path string) (*File, error) {
+	parts := Parts(path)
+	if parts == nil {
+		return nil, os.ErrNotExist
+	}
+	f := &File{path: path, parts: parts, info: Info(filepath.Base(path), parts), cur: -1}
+	for _, p := range parts {
+		f.start = append(f.start, f.size)
+		f.size += p.Size
+	}
+	return f, nil
+}
+
+func (f *File) Read(p []byte) (int, error) {
+	if f.pos >= f.size {
+		return 0, io.EOF
+	}
+	read := 0
+	for len(p) > 0 && f.pos < f.size {
+		i := len(f.parts) - 1
+		for i > 0 && f.start[i] > f.pos {
+			i--
+		}
+		if f.cur != i {
+			if f.f != nil {
+				f.f.Close()
+				f.f = nil
+			}
+			pf, err := os.Open(f.parts[i].Path)
+			if err != nil {
+				return read, err
+			}
+			f.f, f.cur = pf, i
+		}
+		off := f.pos - f.start[i]
+		chunk := p[:min(int64(len(p)), f.parts[i].Size-off)]
+		n, err := f.f.ReadAt(chunk, off)
+		read += n
+		f.pos += int64(n)
+		p = p[n:]
+		if n < len(chunk) {
+			if err == nil || err == io.EOF {
+				err = io.ErrUnexpectedEOF // a part shrank since it was opened
+			}
+			return read, err
+		}
+	}
+	return read, nil
+}
+
+func (f *File) Seek(offset int64, whence int) (int64, error) {
+	switch whence {
+	case io.SeekStart:
+	case io.SeekCurrent:
+		offset += f.pos
+	case io.SeekEnd:
+		offset += f.size
+	default:
+		return f.pos, fmt.Errorf("invalid whence %d", whence)
+	}
+	if offset < 0 {
+		return f.pos, errors.New("negative position")
+	}
+	f.pos = offset
+	return f.pos, nil
+}
+
+// Write: split images are read-only.
+func (f *File) Write([]byte) (int, error) { return 0, os.ErrPermission }
+
+func (f *File) Stat() (os.FileInfo, error) { return f.info, nil }
+
+// Name is the image's host path (".../Name.iso"), as for a real file.
+func (f *File) Name() string { return f.path }
+
+func (f *File) Close() error {
+	if f.f == nil {
+		return nil
+	}
+	err := f.f.Close()
+	f.f, f.cur = nil, -1
+	return err
+}
diff --git a/internal/fs/split/split_test.go b/internal/fs/split/split_test.go
new file mode 100644
index 0000000..7d77130
--- /dev/null
+++ b/internal/fs/split/split_test.go
@@ -0,0 +1,101 @@
+package split
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestPartOf(t *testing.T) {
+	for name, want := range map[string]struct {
+		img string
+		n   int
+	}{
+		"Game.iso.001": {"Game.iso", 1}, "Game (USA).ISO.002": {"Game (USA).ISO", 2}, "a.b.iso.999": {"a.b.iso", 999},
+	} {
+		img, n, ok := PartOf(name)
+		if !ok || img != want.img || n != want.n {
+			t.Errorf("PartOf(%q) = %q %d %v", name, img, n, ok)
+		}
+	}
+	for _, name := range []string{"Game.iso", "Game.iso.000", "Game.iso.01", "Game.iso.0001", "Game.bin.001", ".iso.001", "Game.zso.001"} {
+		if _, _, ok := PartOf(name); ok {
+			t.Errorf("PartOf(%q) accepted", name)
+		}
+	}
+}
+
+func makeSet(t *testing.T, sizes ...int) (string, []byte) {
+	t.Helper()
+	dir := t.TempDir()
+	var all []byte
+	for i, n := range sizes {
+		b := make([]byte, n)
+		for j := range b {
+			b[j] = byte(len(all) + j)
+		}
+		all = append(all, b...)
+		if err := os.WriteFile(filepath.Join(dir, PartName("G.iso", i+1)), b, 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	return filepath.Join(dir, "G.iso"), all
+}
+
+func TestReadAcrossParts(t *testing.T) {
+	path, all := makeSet(t, 1000, 1, 2500, 7)
+	f, err := Open(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer f.Close()
+	if st, _ := f.Stat(); st.Size() != int64(len(all)) || st.Name() != "G.iso" || !st.Mode().IsRegular() {
+		t.Fatalf("stat %v %d", st.Name(), st.Size())
+	}
+	if f.Name() != path {
+		t.Fatalf("name %q", f.Name())
+	}
+	got, err := io.ReadAll(f)
+	if err != nil || !bytes.Equal(got, all) {
+		t.Fatalf("read all: %d bytes %v", len(got), err)
+	}
+	for _, c := range []struct{ off, n int }{{990, 20}, {999, 2}, {1000, 1}, {1001, 2505}, {0, 3508}, {3500, 8}} {
+		if pos, err := f.Seek(int64(c.off), io.SeekStart); err != nil || pos != int64(c.off) {
+			t.Fatal(err)
+		}
+		buf := make([]byte, c.n+10)
+		n, err := io.ReadFull(f, buf)
+		want := all[c.off:min(len(all), c.off+len(buf))]
+		if n != len(want) || !bytes.Equal(buf[:n], want) {
+			t.Fatalf("read %d at %d: %d bytes %v", len(buf), c.off, n, err)
+		}
+	}
+	if pos, _ := f.Seek(-8, io.SeekEnd); pos != int64(len(all)-8) {
+		t.Fatalf("SEEK_END %d", pos)
+	}
+	if _, err := f.Seek(-1, io.SeekStart); err == nil {
+		t.Fatal("negative seek accepted")
+	}
+	if _, err := f.Write([]byte("x")); err == nil {
+		t.Fatal("write accepted")
+	}
+}
+
+func TestPartsStopAtGap(t *testing.T) {
+	path, _ := makeSet(t, 10, 20)
+	os.WriteFile(PartName(path, 4), []byte("x"), 0644)
+	if p := Parts(path); len(p) != 2 || p[1].Size != 20 {
+		t.Fatalf("%+v", p)
+	}
+	if st := Stat(path); st == nil || st.Size() != 30 {
+		t.Fatalf("stat %v", st)
+	}
+	if Stat(filepath.Join(filepath.Dir(path), "none.iso")) != nil {
+		t.Fatal("stat of a missing set")
+	}
+	if _, err := Open(filepath.Join(filepath.Dir(path), "none.iso")); !os.IsNotExist(err) {
+		t.Fatal(err)
+	}
+}
