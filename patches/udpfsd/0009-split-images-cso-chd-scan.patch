+package fs
+
+import (
+	"bytes"
+	"io"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestSplitImageServedAsOne(t *testing.T) {
+	dvd := t.TempDir()
+	other := t.TempDir()
+	data := make([]byte, 5000)
+	for i := range data {
+		data[i] = byte(i * 7)
+	}
+	mkfile(t, filepath.Join(dvd, "sub", "Game.iso.001"), string(data[:3000]))
+	mkfile(t, filepath.Join(dvd, "sub", "Game.iso.002"), string(data[3000:4096]))
+	mkfile(t, filepath.Join(dvd, "sub", "Game.iso.003"), string(data[4096:]))
+	mkfile(t, filepath.Join(dvd, "sub", "Game.iso.005"), "after a gap")
+	mkfile(t, filepath.Join(dvd, "sub", "Real.iso"), "real image")
+	mkfile(t, filepath.Join(dvd, "sub", "Real.iso.001"), "ignored part")
+	mkfile(t, filepath.Join(dvd, "sub", "Real.iso.002"), "ignored part")
+	mkfile(t, filepath.Join(other, "X.iso.001"), "not a game folder")
+	b, err := NewBackend(WithMount("DVD", dvd), WithMount("OTHER", other), WithSplitImages("DVD"), WithReadOnly())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	h, _, err := b.Open("/DVD/sub", os.O_RDONLY, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	sizes := map[string]uint32{}
+	for {
+		ok, name, st, err := b.Dread(h)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !ok {
+			break
+		}
+		sizes[name] = st.Size
+	}
+	b.Close(h)
+	want := map[string]uint32{"Game.iso": 5000, "Game.iso.005": 11, "Real.iso": 10}
+	if len(sizes) != len(want) {
+		t.Fatalf("listing %v", sizes)
+	}
+	for n, s := range want {
+		if sizes[n] != s {
+			t.Fatalf("listing %v, want %v", sizes, want)
+		}
+	}
+	if got := listDir(t, b, "/OTHER"); !eq(got, []string{"X.iso.001"}) {
+		t.Fatalf("split image outside a game folder: %v", got)
+	}
+
+	h, st, err := b.Open("/DVD/sub/Game.iso", os.O_RDONLY, false)
+	if err != nil || st.Size != 5000 {
+		t.Fatalf("open: %d %v", st.Size, err)
+	}
+	if gs, err := b.Getstat("/DVD/sub/Game.iso"); err != nil || gs.Size != 5000 {
+		t.Fatalf("getstat open: %d %v", gs.Size, err)
+	}
+	buf := make([]byte, 128*1024)
+	if pos, err := b.Lseek(h, 2990, io.SeekStart); err != nil || pos != 2990 {
+		t.Fatal(err)
+	}
+	n, got, err := b.Read(h, 2000, buf)
+	if err != nil || n != 2000 || !bytes.Equal(got, data[2990:4990]) {
+		t.Fatalf("read across parts: %d %v", n, err)
+	}
+	if pos, _ := b.Lseek(h, 0, io.SeekEnd); pos != 5000 {
+		t.Fatalf("SEEK_END %d", pos)
+	}
+	if n, _, err := b.Read(h, 100, buf); n != 0 || err != nil {
+		t.Fatalf("at EOF %d %v", n, err)
+	}
+	b.Close(h)
+	if gs, err := b.Getstat("/DVD/sub/Game.iso"); err != nil || gs.Size != 5000 {
+		t.Fatalf("getstat closed: %d %v", gs.Size, err)
+	}
+	if got, err := readAll(t, b, "/DVD/sub/Real.iso"); err != nil || got != "real image" {
+		t.Fatalf("real Real.iso: %q %v", got, err)
+	}
+	if _, err := readAll(t, b, "/OTHER/X.iso"); err == nil {
+		t.Fatal("split image served outside a game folder")
+	}
+	if _, _, err := b.Open("/DVD/sub/Game.iso", os.O_RDWR, false); err == nil {
+		t.Fatal("split image opened for writing")
+	}
+	// Over /.lz4f too.
+	h, st, err = b.Open("/.lz4f/DVD/sub/Game.iso", os.O_RDONLY, false)
+	if err != nil || st.Size != 5000 {
+		t.Fatalf("framed: %d %v", st.Size, err)
+	}
+	if got := readFrames(t, b, h, 4096); !bytes.Equal(got, data) {
+		t.Fatal("framed split image differs")
+	}
+	b.Close(h)
+}
