+
+// writeCSO stores data as a CISO with every block flagged plain
+// (uncompressed): n+1 index entries, bit 31 = plain, alignment 0.
+func writeCSO(t *testing.T, path string, data []byte) {
+	t.Helper()
+	const bs = 2048
+	n := (len(data) + bs - 1) / bs
+	hdr := make([]byte, 24)
+	copy(hdr, "CISO")
+	binary.LittleEndian.PutUint32(hdr[4:], 24)
+	binary.LittleEndian.PutUint64(hdr[8:], uint64(len(data)))
+	binary.LittleEndian.PutUint32(hdr[16:], bs)
+	hdr[20] = 1 // version
+	idx := make([]byte, 4*(n+1))
+	pos := uint32(24 + 4*(n+1))
+	for i := 0; i <= n; i++ {
+		binary.LittleEndian.PutUint32(idx[4*i:], pos|0x80000000)
+		pos += bs
+	}
+	out := append(append(hdr, idx...), data...)
+	out = append(out, make([]byte, n*bs-len(data))...)
+	if err := os.WriteFile(path, out, 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// writeCHD stores data as an uncompressed CHD v5 (DVD-style: 2048-byte
+// units, 4096-byte hunks): header, map of 32-bit big-endian hunk numbers,
+// then the hunks aligned to the hunk size.
+func writeCHD(t *testing.T, path string, data []byte) {
+	t.Helper()
+	const hunk = 4096
+	hunks := (len(data) + hunk - 1) / hunk
+	first := (124 + 4*hunks + hunk - 1) / hunk // hunk number of the first data hunk
+	out := make([]byte, (first+hunks)*hunk)
+	copy(out, "MComprHD")
+	binary.BigEndian.PutUint32(out[8:], 124)
+	binary.BigEndian.PutUint32(out[12:], 5)
+	binary.BigEndian.PutUint64(out[32:], uint64(len(data))) // logical bytes
+	binary.BigEndian.PutUint64(out[40:], 124)               // map offset
+	binary.BigEndian.PutUint32(out[56:], hunk)
+	binary.BigEndian.PutUint32(out[60:], 2048)
+	for i := 0; i < hunks; i++ {
+		binary.BigEndian.PutUint32(out[124+4*i:], uint32(first+i))
+	}
+	copy(out[first*hunk:], data)
+	if err := os.WriteFile(path, out, 0644); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func scanOne(t *testing.T, mount string, files map[string][]byte) (string, []string) {
+	t.Helper()
+	base := t.TempDir()
+	dir := filepath.Join(base, mount)
+	os.MkdirAll(dir, 0755)
+	for name, data := range files {
+		if err := os.WriteFile(filepath.Join(dir, name), data, 0644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	cache := filepath.Join(base, "c")
+	if _, err := Run(Options{Folders: []Folder{{Mount: mount, Dir: dir}}, CacheDir: cache}); err != nil {
+		t.Fatal(err)
+	}
+	return readManifest(t, cache)
+}
+
+func TestScanSplitImage(t *testing.T) {
+	img := buildISO("SPLIT", 1000, 1000, cnfOK, false)
+	other := buildISO("REAL", 1000, 1000, strings.Replace(cnfOK, "SLUS_203.12", "SLUS_210.90", 1), false)
+	_, lines := scanOne(t, "DVD", map[string][]byte{
+		"Split Game (USA).iso.001": img[:600*2048],
+		"Split Game (USA).iso.002": img[600*2048 : 900*2048],
+		"Split Game (USA).iso.003": img[900*2048:],
+		"Split Game (USA).iso.005": []byte("after a gap: not part of the set"),
+		"Real.iso":                 other,
+		"Real.iso.001":             []byte("a real Real.iso wins"),
+	})
+	want := []string{
+		"/DVD/Real.iso\tok\tSLUS_210.90\tReal\t2048000\tDVD\t0\t-\t-",
+		"/DVD/Split Game (USA).iso\tok\tSLUS_203.12\tSplit Game\t2048000\tDVD\t0\t-\t-",
+	}
+	if strings.Join(lines, "\n") != strings.Join(want, "\n") {
+		t.Fatalf("manifest:\n%s\nwant\n%s", strings.Join(lines, "\n"), strings.Join(want, "\n"))
+	}
+}
+
+func TestScanSplitImageCache(t *testing.T) {
+	base := t.TempDir()
+	dir := filepath.Join(base, "G")
+	os.MkdirAll(dir, 0755)
+	img := buildISO("X", 1000, 1000, cnfOK, false)
+	os.WriteFile(filepath.Join(dir, "a.iso.001"), img[:500*2048], 0644)
+	os.WriteFile(filepath.Join(dir, "a.iso.002"), img[500*2048:], 0644)
+	o := Options{Folders: []Folder{{"GAMES", dir}}, CacheDir: filepath.Join(base, "c")}
+	if _, err := Run(o); err != nil {
+		t.Fatal(err)
+	}
+	probes := 0
+	probeHook = func(string) { probes++ }
+	defer func() { probeHook = nil }()
+	if _, err := Run(o); err != nil || probes != 0 {
+		t.Fatalf("unchanged split image re-probed (%d) %v", probes, err)
+	}
+	// A third part changes the image (size and time): probed again.
+	os.WriteFile(filepath.Join(dir, "a.iso.003"), make([]byte, 2048), 0644)
+	if res, err := Run(o); err != nil || probes != 1 || res.Games != 1 {
+		t.Fatalf("changed split image: probes %d %+v %v", probes, res, err)
+	}
+}
+
+func TestScanCSO(t *testing.T) {
+	cso := filepath.Join(t.TempDir(), "x.cso")
+	writeCSO(t, cso, buildISO("CSO", 1000, 1000, cnfOK, false))
+	b, _ := os.ReadFile(cso)
+	_, lines := scanOne(t, "CD", map[string][]byte{"Game (Europe).cso": b, "bad.cso": []byte("CISO but not really")})
+	want := []string{
+		"/CD/Game (Europe).cso.iso\tok\tSLUS_203.12\tGame\t2048000\tCD\t0\t-\t-",
+	}
+	if len(lines) != 2 || lines[0] != want[0] || !strings.HasPrefix(lines[1], "/CD/bad.cso.iso\tinvalid:") {
+		t.Fatalf("manifest:\n%s", strings.Join(lines, "\n"))
+	}
+}
+
+func TestScanCHD(t *testing.T) {
+	p := filepath.Join(t.TempDir(), "x.chd")
+	writeCHD(t, p, buildISO("CHD", 1000, 1000, cnfOK, true))
+	b, _ := os.ReadFile(p)
+	_, lines := scanOne(t, "DVD", map[string][]byte{"Game.chd": b})
+	if !chd.Available {
+		// Without CHD support udpfsd cannot serve it: not listed.
+		if len(lines) != 0 {
+			t.Fatalf("CHD listed without CHD support: %q", lines)
+		}
+		return
+	}
+	want := "/DVD/Game.chd.iso\tok\tSLUS_203.12\tGame\t2048000\tDVD\t0\t-\t-"
+	if len(lines) != 1 || lines[0] != want {
+		t.Fatalf("manifest %q\nwant %q", lines, want)
+	}
+}
+
+func TestOpenLogicalFormats(t *testing.T) {
+	dir := t.TempDir()
+	img := buildISO("FMT", 100, 100, cnfOK, false)
+	writeCSO(t, filepath.Join(dir, "a.cso"), img)
+	writeZSO(t, filepath.Join(dir, "a.zso"), img)
+	os.WriteFile(filepath.Join(dir, "s.iso.001"), img[:10*2048+5], 0644)
+	os.WriteFile(filepath.Join(dir, "s.iso.002"), img[10*2048+5:], 0644)
+	paths := []string{"a.cso", "a.zso", "s.iso"}
+	if chd.Available {
+		writeCHD(t, filepath.Join(dir, "a.chd"), img)
+		paths = append(paths, "a.chd")
+	}
+	for _, name := range paths {
+		r, size, c, err := OpenLogical(filepath.Join(dir, name))
+		if err != nil || size != int64(len(img)) {
+			t.Fatalf("%s: %d %v", name, size, err)
+		}
+		buf := make([]byte, 3*2048)
+		if _, err := r.ReadAt(buf, 9*2048); err != nil || string(buf) != string(img[9*2048:12*2048]) {
+			t.Fatalf("%s: ReadAt across a block/part boundary: %v", name, err)
+		}
+		c.Close()
+	}
+}
