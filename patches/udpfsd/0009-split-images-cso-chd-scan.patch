+		}
+		out = append(out, e)
+	}
+	for key, img := range first {
+		if !present[key] && len(parts[key]) == count[key] {
+			out = append(out, virtualEntry{split.Info(img, parts[key])})
+		}
+	}
+	sort.Slice(out, func(i, j int) bool { return out[i].Name() < out[j].Name() })
+	return out
+}
