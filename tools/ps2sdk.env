# Pinned PS2SDK the installer is built against (shell syntax).
# ps2dev/ps2sdk master 2026-10-06. Needed for atad's LBA48 support on the
# DESR: since 77abbe2/873208c (2026-08-31/09-03) ps2atad detects DVRP
# firmware that is LBA48-aware (dvrpwned; "PS2LBA48" in IDENTIFY words
# 121-124) and then addresses the whole PS2 area with LBA48 instead of
# the 28-bit DVRP workaround; f30f05e fixes 65536-sector LBA48 transfers.
# tools/build-ps2sdk.sh builds it with the installed PS2DEV toolchain
# into PS2SDK_PREFIX; tools/ps2env.sh uses it when it exists.
PS2SDK_REPO=https://github.com/ps2dev/ps2sdk.git
PS2SDK_REV=2c670453980fcc3fe46ead6399b730b12c8556eb
PS2SDK_PREFIX=/usr/local/ps2dev/ps2sdk-2c67045
# The string ps2atad.irx prints when it finds such firmware; the build
# refuses an SDK whose ps2atad.irx lacks it.
PS2SDK_ATAD_LBA48_MARK="LBA48-capable DVRP firmware detected"
