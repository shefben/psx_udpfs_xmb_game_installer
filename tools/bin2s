#!/usr/bin/env python3
"""Minimal stand-in for the old ps2sdk `bin2s` tool.

Usage: bin2s <input> <output.s> <symbol>

Emits a MIPS assembly file defining `<symbol>` (the bytes, 16-byte
aligned, in .data) and `size_<symbol>` (a 32-bit word), which is what
OPL-Launcher's Makefile expects. Current PS2SDK only ships bin2c, so
this shim lets the pinned OPL-Launcher build without patching it.
"""
import sys


def main():
    if len(sys.argv) != 4:
        sys.stderr.write("usage: bin2s <input> <output.s> <symbol>\n")
        return 1
    src, dst, sym = sys.argv[1:]
    data = open(src, "rb").read()
    with open(dst, "w") as f:
        f.write(".sdata\n.globl size_%s\n.p2align 2\nsize_%s: .word %d\n\n" % (sym, sym, len(data)))
        f.write(".data\n.globl %s\n.p2align 4\n%s:\n" % (sym, sym))
        for i in range(0, len(data), 16):
            f.write("\t.byte " + ",".join(str(b) for b in data[i:i + 16]) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
