# Pinned libchdr (CHD reader, BSD-3-Clause) that tools/build-udpfsd.sh links
# statically into the udpfsd binaries for CHD support. Master of 2026-09-27
# ("Merge pull request #196 from Clownacy/ansi-c-fixes", version 0.3.0); it
# bundles the lzma 26.02, miniz 3.1.2 and zstd 1.5.7 sources it decodes with,
# so no system compression library is used. The script fetches exactly this
# commit with git and checks `git rev-parse HEAD` against it (the commit id is
# the content hash).
LIBCHDR_URL=https://github.com/rtissera/libchdr
LIBCHDR_COMMIT=607694ca0812edfc9cc2030c64634fc2393668de
