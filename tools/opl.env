# Pinned Open PS2 Loader runtime that udpfsd hands to the console when OPL
# is missing on the HDD. Official ps2homebrew build of commit 3e3f34e (the
# same revision as reference/Open-PS2-Loader). It was published under the
# rolling "latest" tag, so the URL may disappear: the archive is kept in
# vendor/opl/ and both files are pinned by SHA-256. AFL-3.0 (LICENSE inside).
OPL_VERSION=v1.2.0-Beta-2245-3e3f34e
OPL_ARCHIVE=vendor/opl/OPNPS2LD-v1.2.0-Beta-2245-3e3f34e.7z
OPL_URL=https://github.com/ps2homebrew/Open-PS2-Loader/releases/download/latest/OPNPS2LD-v1.2.0-Beta-2245-3e3f34e.7z
OPL_ARCHIVE_SHA256=3386751f3ffea5b1c47e836072a3c7d675864546726f2f9c82d0147b85322049
OPL_ELF_MEMBER=OPNPS2LD/OPNPS2LD-v1.2.0-Beta-2245-3e3f34e.ELF
OPL_ELF_SHA256=3e01aad93ed6ed26c450db27496657f9e214e165af77c9c971a789f90f968c02
